<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <meta name="description" content="About ICUBE World & ICUBE Info Solution - Official examination authority for technical assessments and candidate evaluations.">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>📝</text></svg>">
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --bg: #0d1117;
      --card-bg: #161b22;
      --border: #30363d;
      --text: #e6edf3;
      --muted: #8b949e;
      --green: #2ea043;
      --green-hover: #238636;
      --accent: #58a6ff;
    }
    body {
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      background: var(--bg);
      color: var(--text);
      line-height: 1.6;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }
    header.site-header {
      border-bottom: 1px solid var(--border);
      background: rgba(13, 17, 23, 0.95);
      position: sticky;
      top: 0;
      z-index: 100;
      padding: 14px 24px;
    }
    .header-inner {
      max-width: 980px;
      margin: 0 auto;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      flex-wrap: wrap;
    }
    .brand {
      display: flex;
      align-items: center;
      gap: 10px;
      text-decoration: none;
      color: #fff;
      font-size: 1.15rem;
      font-weight: 700;
    }
    .brand-badge {
      font-size: 0.72rem;
      background: #21262d;
      color: var(--muted);
      border: 1px solid var(--border);
      padding: 3px 8px;
      border-radius: 6px;
      font-weight: 500;
    }
    .nav-links {
      display: flex;
      align-items: center;
      gap: 16px;
    }
    .nav-links a {
      color: var(--muted);
      text-decoration: none;
      font-size: 0.88rem;
      transition: color 0.2s;
    }
    .nav-links a:hover, .nav-links a.active {
      color: #fff;
    }
    .btn-header {
      background: var(--green);
      color: #fff;
      padding: 7px 14px;
      border-radius: 6px;
      font-weight: 600;
      font-size: 0.84rem;
      text-decoration: none;
      transition: background 0.2s;
    }
    .btn-header:hover {
      background: var(--green-hover);
    }

    main.content-wrapper {
      max-width: 980px;
      margin: 0 auto;
      padding: 40px 20px 60px;
      flex: 1;
      width: 100%;
    }

    .page-title-section {
      border-bottom: 1px solid var(--border);
      padding-bottom: 24px;
      margin-bottom: 32px;
    }
    .company-tag {
      display: inline-block;
      font-size: 0.75rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--green);
      margin-bottom: 8px;
    }
    .page-title-section h1 {
      font-size: 2.1rem;
      font-weight: 800;
      color: #fff;
      letter-spacing: -0.02em;
      margin-bottom: 12px;
    }
    .partner-banner {
      background: #161b22;
      border: 1px solid var(--border);
      border-left: 4px solid var(--green);
      border-radius: 6px;
      padding: 14px 18px;
      font-size: 0.92rem;
      color: var(--text);
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 14px;
      flex-wrap: wrap;
    }
    .partner-banner a {
      color: var(--accent);
      text-decoration: underline;
      font-weight: 600;
    }

    .grid-section {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 20px;
      margin-bottom: 32px;
    }
    @media (max-width: 720px) {
      .grid-section { grid-template-columns: 1fr; }
    }

    .card {
      background: var(--card-bg);
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 24px;
    }
    .card h2 {
      font-size: 1.15rem;
      font-weight: 700;
      color: #fff;
      margin-bottom: 12px;
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .card p {
      font-size: 0.9rem;
      color: var(--muted);
      line-height: 1.6;
      margin-bottom: 12px;
    }
    .card p:last-child { margin-bottom: 0; }
    .card strong { color: var(--text); }

    .feature-list {
      list-style: none;
      margin-top: 14px;
    }
    .feature-list li {
      padding: 8px 0;
      border-top: 1px solid rgba(255, 255, 255, 0.05);
      font-size: 0.88rem;
      color: var(--muted);
      display: flex;
      align-items: flex-start;
      gap: 10px;
    }
    .feature-list li strong {
      color: #fff;
    }

    .contact-card {
      background: #161b22;
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 24px;
      margin-top: 24px;
    }
    .contact-card h2 {
      font-size: 1.15rem;
      font-weight: 700;
      color: #fff;
      margin-bottom: 16px;
    }
    .contact-row {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 16px;
    }
    .contact-item {
      background: #0d1117;
      border: 1px solid var(--border);
      border-radius: 6px;
      padding: 14px 16px;
    }
    .contact-label {
      font-size: 0.74rem;
      text-transform: uppercase;
      font-weight: 700;
      letter-spacing: 0.05em;
      color: var(--muted);
      margin-bottom: 4px;
    }
    .contact-val {
      font-size: 0.92rem;
      font-weight: 600;
      color: #fff;
    }
    .contact-val a {
      color: var(--accent);
      text-decoration: none;
    }
    .contact-val a:hover {
      text-decoration: underline;
    }

    .action-row {
      margin-top: 36px;
      display: flex;
      gap: 12px;
      flex-wrap: wrap;
    }
    .btn-main {
      background: var(--green);
      color: #fff;
      padding: 10px 20px;
      border-radius: 6px;
      font-weight: 600;
      font-size: 0.92rem;
      text-decoration: none;
      transition: background 0.2s;
    }
    .btn-main:hover {
      background: var(--green-hover);
    }
    .btn-secondary {
      background: #21262d;
      color: var(--text);
      border: 1px solid var(--border);
      padding: 10px 18px;
      border-radius: 6px;
      font-weight: 600;
      font-size: 0.92rem;
      text-decoration: none;
      transition: border-color 0.2s;
    }
    .btn-secondary:hover {
      border-color: #8b949e;
    }

    footer.site-footer {
      border-top: 1px solid var(--border);
      background: #0d1117;
      padding: 24px;
      text-align: center;
      font-size: 0.82rem;
      color: var(--muted);
    }
    footer.site-footer a {
      color: var(--muted);
      text-decoration: underline;
      margin: 0 8px;
    }
    footer.site-footer a:hover {
      color: #fff;
    }
  </style>
</head>
<body>

  <!-- Header -->
  <header class="site-header">
    <div class="header-inner">
      <a href="/" class="brand">
        <span>ICUBE World</span>
        <span class="brand-badge">ICUBE Info Solution</span>
      </a>
      <nav class="nav-links">
        <a href="/" class="btn-header">← Candidate Sign In</a>
        <a href="/terms">Examination Rules</a>
        <a href="https://bitzbolt.online" target="_blank" rel="noopener noreferrer">bitzbolt.online ↗</a>
      </nav>
    </div>
  </header>

  <!-- Main Content -->
  <main class="content-wrapper">
    <div class="page-title-section">
      <span class="company-tag">Examination Authority</span>
      <h1>About ICUBE World (ICUBE Info Solution)</h1>
      <div class="partner-banner">
        <div>
          Official examination authority administering candidate assessments for <strong>Bitzbolt</strong>.
        </div>
        <a href="https://bitzbolt.online" target="_blank" rel="noopener noreferrer">Visit bitzbolt.online →</a>
      </div>
    </div>

    <div class="grid-section">
      <div class="card">
        <h2>🏢 Examination Authority</h2>
        <p>
          <strong>ICUBE World</strong> (operating alongside <strong>ICUBE Info Solution</strong>) is the primary examination authority responsible for administering, proctoring, and evaluating technical assessments.
        </p>
        <p>
          We provide structured, verified technical examination environments for candidates applying for engineering, software development, data science, and technical roles.
        </p>
      </div>

      <div class="card">
        <h2>🤝 Assessments for Bitzbolt</h2>
        <p>
          All candidate assessments on this platform are administered and evaluated by <strong>ICUBE World</strong> for <strong>Bitzbolt</strong> (<a href="https://bitzbolt.online" target="_blank" rel="noopener noreferrer" style="color: var(--accent);">bitzbolt.online</a>).
        </p>
        <p>
          When you receive an assessment invitation, your examination is scheduled, timed, and evaluated on this secure system.
        </p>
      </div>
    </div>

    <div class="card" style="margin-bottom: 24px;">
      <h2>📋 Examination Standards &amp; Candidate Evaluation</h2>
      <p>
        To ensure fair, accurate, and objective hiring decisions, ICUBE World maintains rigorous evaluation standards:
      </p>
      <ul class="feature-list">
        <li>
          <span>✓</span>
          <div>
            <strong>Automated Assessment Delivery:</strong> Timed objective questions (MCQs) and domain-specific challenges tailored to job tracks.
          </div>
        </li>
        <li>
          <span>✓</span>
          <div>
            <strong>Strict Exam Integrity:</strong> Full-screen monitoring, tab switch detection, and tamper prevention to maintain exam honesty.
          </div>
        </li>
        <li>
          <span>✓</span>
          <div>
            <strong>Manual Verification:</strong> Submitted answers and code solutions are reviewed by recruitment evaluators alongside resume verification.
          </div>
        </li>
        <li>
          <span>✓</span>
          <div>
            <strong>Interview Progression:</strong> Verified scores and evaluation reports are directly shared with Bitzbolt for interview scheduling.
          </div>
        </li>
      </ul>
    </div>

    <!-- Contact & Entity Details -->
    <div class="contact-card">
      <h2>📌 Organization &amp; Support Details</h2>
      <div class="contact-row">
        <div class="contact-item">
          <div class="contact-label">Examination Company</div>
          <div class="contact-val">ICUBE World</div>
        </div>
        <div class="contact-item">
          <div class="contact-label">Operating Entity</div>
          <div class="contact-val">ICUBE Info Solution</div>
        </div>
        <div class="contact-item">
          <div class="contact-label">Client / Partner</div>
          <div class="contact-val"><a href="https://bitzbolt.online" target="_blank" rel="noopener noreferrer">Bitzbolt (bitzbolt.online)</a></div>
        </div>
        <div class="contact-item">
          <div class="contact-label">Candidate Support</div>
          <div class="contact-val"><a href="mailto:support@icubeinfosolution.com">support@icubeinfosolution.com</a></div>
        </div>
      </div>
    </div>

    <!-- Action Row -->
    <div class="action-row">
      <a href="/" class="btn-main">Go to Assessment Portal / Sign In →</a>
      <a href="/terms" class="btn-secondary">View Examination Terms &amp; Conditions</a>
    </div>
  </main>

  <!-- Footer -->
  <footer class="site-footer">
    <div>
      &copy; <%= new Date().getFullYear() %> <strong>ICUBE World</strong> &bull; <strong>ICUBE Info Solution</strong>. All Rights Reserved.
    </div>
    <div style="margin-top: 8px;">
      Assessments for <a href="https://bitzbolt.online" target="_blank" rel="noopener noreferrer">Bitzbolt (bitzbolt.online)</a> |
      <a href="/about">About Us</a> |
      <a href="/terms">Examination Terms</a> |
      <a href="/admin/login">Admin Portal</a>
    </div>
  </footer>

</body>
</html>

