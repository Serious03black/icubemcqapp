<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>ICUBE Info Solution - Candidate Skill Assessment Platform</title>
  <meta name="description" content="ICUBE Info Solution official candidate skill assessment platform. Complete technical assessment, manual verification of resume and answers, and interview scheduling." />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet" />
  <style>
    *,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
    :root{--green:#22c55e;--green-dim:rgba(34,197,94,.15);--bg:#0a0a0a;--bg2:#0f0f0f;--card:#141414;--border:rgba(255,255,255,.07);--text:#f1f5f9;--muted:#8a9ab5}
    body{font-family:'Inter',sans-serif;background:var(--bg);color:var(--text);min-height:100vh;overflow-x:hidden}
    .bg-glow{position:fixed;top:-300px;left:30%;width:900px;height:700px;background:radial-gradient(ellipse,rgba(34,197,94,.09) 0%,transparent 65%);pointer-events:none;z-index:0}
    .bg-glow2{position:fixed;bottom:-200px;right:0;width:500px;height:500px;background:radial-gradient(ellipse,rgba(34,197,94,.06) 0%,transparent 70%);pointer-events:none;z-index:0}

    /* LAYOUT */
    .page-wrapper{position:relative;z-index:1;display:grid;grid-template-columns:1fr 420px;min-height:100vh}

    /* HERO */
    .hero{display:flex;flex-direction:column;justify-content:center;padding:60px 60px 60px 80px}
    .brand{font-size:1.55rem;font-weight:800;letter-spacing:-.5px;margin-bottom:36px;color:#fff;display:flex;align-items:center;gap:10px}
    .brand-dot{width:10px;height:10px;background:var(--green);border-radius:50%;box-shadow:0 0 12px var(--green)}
    .brand span{color:var(--green)}

    .invite-banner{background:linear-gradient(135deg,rgba(34,197,94,.18),rgba(34,197,94,.05));border:1px solid rgba(34,197,94,.35);border-radius:12px;padding:14px 18px;margin-bottom:24px;display:flex;align-items:center;gap:14px;max-width:620px}
    .invite-tag{background:var(--green);color:#000;font-weight:800;font-size:.72rem;letter-spacing:.06em;text-transform:uppercase;padding:5px 11px;border-radius:6px;white-space:nowrap;display:inline-flex;align-items:center;gap:6px}
    .invite-text{font-size:.85rem;color:#e2e8f0;line-height:1.45}
    .invite-text strong{color:#fff;font-weight:700}

    .top-badge{display:inline-flex;align-items:center;gap:8px;background:var(--green-dim);border:1px solid rgba(34,197,94,.25);color:var(--green);font-size:.78rem;font-weight:600;padding:7px 16px;border-radius:999px;margin-bottom:22px;width:fit-content;letter-spacing:.04em}

    .hero h1{font-size:clamp(2.4rem,4vw,3.5rem);font-weight:900;line-height:1.1;letter-spacing:-1.8px;color:#fff;margin-bottom:20px}
    .hero h1 .hl{color:var(--green)}

    .hero-desc{font-size:.98rem;color:var(--muted);line-height:1.7;max-width:560px;margin-bottom:36px}

    /* DOMAIN GRID */
    .domains-label{font-size:.72rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--muted);margin-bottom:14px;opacity:.7}
    .domains{display:flex;flex-wrap:wrap;gap:9px;margin-bottom:36px;max-width:580px}
    .domain-chip{padding:7px 15px;border-radius:999px;border:1px solid var(--border);font-size:.8rem;font-weight:500;color:#cbd5e1;background:rgba(255,255,255,.04);transition:border-color .2s,color .2s,background .2s,transform .2s;cursor:default}
    .domain-chip:hover{border-color:rgba(34,197,94,.4);color:#fff;background:var(--green-dim);transform:translateY(-2px)}
    .domain-chip.featured{border-color:rgba(34,197,94,.3);color:var(--green);background:var(--green-dim)}

    /* VALUE CARDS - HIRING WORKFLOW */
    .value-cards{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-bottom:38px;max-width:600px}
    .val-card{background:var(--card);border:1px solid var(--border);border-radius:14px;padding:18px 16px;transition:border-color .25s,transform .25s}
    .val-card:hover{border-color:rgba(34,197,94,.35);transform:translateY(-3px)}
    .val-step{font-size:.68rem;font-weight:800;letter-spacing:.08em;text-transform:uppercase;color:var(--green);margin-bottom:6px}
    .val-icon{font-size:1.3rem;margin-bottom:8px}
    .val-title{font-size:.88rem;font-weight:700;color:#fff;margin-bottom:6px}
    .val-desc{font-size:.75rem;color:var(--muted);line-height:1.45}

    /* CTA */
    .hero-cta{display:flex;gap:14px;flex-wrap:wrap;margin-bottom:36px}
    .btn-green{display:inline-flex;align-items:center;gap:8px;background:var(--green);color:#000;font-weight:700;font-size:.95rem;padding:14px 30px;border-radius:8px;border:none;cursor:pointer;text-decoration:none;transition:background .2s,transform .2s,box-shadow .2s;box-shadow:0 0 28px rgba(34,197,94,.3)}
    .btn-green:hover{background:#16a34a;transform:translateY(-2px);box-shadow:0 0 40px rgba(34,197,94,.5)}
    .btn-outline{display:inline-flex;align-items:center;gap:8px;background:transparent;color:var(--text);font-weight:600;font-size:.95rem;padding:14px 28px;border-radius:8px;border:1px solid var(--border);cursor:pointer;text-decoration:none;transition:all .2s}
    .btn-outline:hover{border-color:rgba(255,255,255,.22);background:rgba(255,255,255,.05);transform:translateY(-2px)}

    /* TRUST STRIP */
    .trust-strip{display:flex;gap:24px;flex-wrap:wrap;padding-top:28px;border-top:1px solid var(--border)}
    .trust-item{display:flex;align-items:center;gap:9px;font-size:.82rem;color:var(--muted)}
    .trust-dot{width:7px;height:7px;background:var(--green);border-radius:50%;flex-shrink:0;box-shadow:0 0 6px var(--green)}

    /* AUTH PANEL */
    .auth-panel{background:var(--bg2);border-left:1px solid var(--border);display:flex;flex-direction:column;justify-content:center;padding:52px 38px;position:sticky;top:0;height:100vh;overflow-y:auto}
    .auth-tabs{display:flex;background:rgba(255,255,255,.04);border-radius:10px;padding:4px;margin-bottom:30px}
    .auth-tab{flex:1;text-align:center;padding:10px;border-radius:7px;font-size:.88rem;font-weight:600;cursor:pointer;color:var(--muted);transition:all .2s;border:none;background:transparent}
    .auth-tab.active{background:var(--green);color:#000}
    .auth-form{display:none}
    .auth-form.active{display:block}
    .auth-title{font-size:1.35rem;font-weight:800;color:#fff;margin-bottom:5px}
    .auth-sub{font-size:.84rem;color:var(--muted);margin-bottom:26px;line-height:1.5}
    .form-group{margin-bottom:16px}
    .form-label{display:block;font-size:.78rem;font-weight:700;color:var(--muted);margin-bottom:7px;letter-spacing:.05em;text-transform:uppercase}
    .form-input{width:100%;padding:12px 14px;background:rgba(255,255,255,.04);border:1px solid var(--border);border-radius:8px;color:var(--text);font-size:.92rem;font-family:'Inter',sans-serif;outline:none;transition:border-color .2s,box-shadow .2s}
    .form-input:focus{border-color:var(--green);box-shadow:0 0 0 3px rgba(34,197,94,.1)}
    .form-input::placeholder{color:rgba(148,163,184,.4)}
    .form-select{width:100%;padding:12px 14px;background:rgba(255,255,255,.04);border:1px solid var(--border);border-radius:8px;color:var(--text);font-size:.92rem;font-family:'Inter',sans-serif;outline:none;cursor:pointer;transition:border-color .2s,box-shadow .2s}
    .form-select:focus{border-color:var(--green);box-shadow:0 0 0 3px rgba(34,197,94,.1)}
    .form-select option{background:#181818}
    .btn-submit{width:100%;padding:13px;background:var(--green);color:#000;font-weight:700;font-size:.95rem;border:none;border-radius:8px;cursor:pointer;margin-top:10px;transition:all .2s;box-shadow:0 0 20px rgba(34,197,94,.2)}
    .btn-submit:hover{background:#16a34a;transform:translateY(-1px);box-shadow:0 0 32px rgba(34,197,94,.4)}
    .switch-auth{text-align:center;margin-top:18px;font-size:.83rem;color:var(--muted)}
    .switch-link{color:var(--green);text-decoration:none;font-weight:600;cursor:pointer;background:none;border:none;font-size:inherit;font-family:inherit}
    .switch-link:hover{text-decoration:underline}
    .panel-note{margin-top:22px;padding:14px 16px;background:var(--green-dim);border:1px solid rgba(34,197,94,.2);border-radius:10px;font-size:.78rem;color:rgba(34,197,94,.9);line-height:1.6}
    .panel-note strong{color:var(--green);display:block;margin-bottom:4px}
    .alert-msg{padding:10px 14px;border-radius:8px;font-size:.83rem;margin-bottom:16px;background:rgba(239,68,68,.1);border:1px solid rgba(239,68,68,.25);color:#fca5a5}
    .bottom-trust{margin-top:16px;text-align:center;font-size:.73rem;color:rgba(148,163,184,.35);line-height:1.6}

    /* PARTICLES */
    .particle{position:fixed;border-radius:50%;background:rgba(34,197,94,.12);animation:float linear infinite;pointer-events:none;z-index:0}
    @keyframes float{0%{transform:translateY(110vh) scale(0);opacity:0}10%{opacity:.8}90%{opacity:.8}100%{transform:translateY(-10vh) scale(1);opacity:0}}

    @media(max-width:960px){
      .page-wrapper{grid-template-columns:1fr}
      .hero{padding:48px 24px 40px}
      .auth-panel{position:static;height:auto;border-left:none;border-top:1px solid var(--border);padding:40px 24px}
      .value-cards{grid-template-columns:repeat(3,1fr)}
      .brand{margin-bottom:36px}
    }
    @media(max-width:560px){.value-cards{grid-template-columns:1fr 1fr}}
  </style>
</head>
<body>
  <div class="bg-glow"></div>
  <div class="bg-glow2"></div>
  <div class="particle" style="width:7px;height:7px;left:8%;animation-duration:19s;animation-delay:0s;"></div>
  <div class="particle" style="width:4px;height:4px;left:22%;animation-duration:25s;animation-delay:5s;"></div>
  <div class="particle" style="width:9px;height:9px;left:55%;animation-duration:21s;animation-delay:2s;"></div>
  <div class="particle" style="width:5px;height:5px;left:75%;animation-duration:17s;animation-delay:9s;"></div>
  <div class="particle" style="width:3px;height:3px;left:40%;animation-duration:23s;animation-delay:7s;"></div>

  <div class="page-wrapper">
    <!-- HERO -->
    <section class="hero">
      <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:32px; flex-wrap:wrap; gap:12px;">
        <a href="/" style="text-decoration:none; color:inherit; margin-bottom:0;" class="brand">
          <div class="brand-dot"></div>ICUBE <span>Info Solution</span>
        </a>
        <a href="/" style="display:inline-flex; align-items:center; gap:8px; color:var(--muted); font-size:0.85rem; text-decoration:none; padding:8px 16px; border:1px solid var(--border); border-radius:8px; transition:all .2s; background:rgba(255,255,255,.03);">
          &#8592; Back to Main Website
        </a>
      </div>

      <!-- INVITATION NOTICE -->
      <div class="invite-banner">
        <span class="invite-tag">&#129309; Application Status</span>
        <div class="invite-text">
          <strong>You are invited for assessment for your job application.</strong> Give assessment, complete manual verification of your resume and answers, and schedule your interview.
        </div>
      </div>

      <div class="top-badge">&#128227; Pre-Interview Technical Evaluation</div>

      <h1>Candidate Skill Assessment.<br>Manual Verification. <span class="hl">Interview Scheduling.</span></h1>

      <p class="hero-desc">
        Welcome! You have been invited to complete your technical assessment for your job application. Complete your exam, after which our recruitment team will manually verify your resume and submitted answers to schedule your interview.
      </p>

      <!-- DOMAIN CHIPS -->
      <div class="domains-label">Assessment Fields &amp; Technologies</div>
      <div class="domains">
        <span class="domain-chip featured">&#129504; Artificial Intelligence</span>
        <span class="domain-chip featured">&#128200; Data Science</span>
        <span class="domain-chip featured">&#129302; Robotics</span>
        <span class="domain-chip">&#127760; Machine Learning</span>
        <span class="domain-chip">&#128187; MERN Stack</span>
        <span class="domain-chip">&#9749; Java Full Stack</span>
        <span class="domain-chip">&#128013; Python Full Stack</span>
        <span class="domain-chip">&#9729;&#65039; Cloud Computing</span>
        <span class="domain-chip">&#128295; DevOps</span>
        <span class="domain-chip">&#127914; UI / UX Design</span>
        <span class="domain-chip">&#128202; Digital Marketing</span>
        <span class="domain-chip">&#128274; Cybersecurity</span>
      </div>

      <!-- VALUE CARDS: 3-STEP HIRING PIPELINE -->
      <div class="value-cards">
        <div class="val-card">
          <div class="val-step">Step 1</div>
          <div class="val-icon">&#128221;</div>
          <div class="val-title">Give Assessment</div>
          <div class="val-desc">Attempt your assigned MCQs and programming challenges in your domain.</div>
        </div>
        <div class="val-card">
          <div class="val-step">Step 2</div>
          <div class="val-icon">&#128269;</div>
          <div class="val-title">Manual Verification</div>
          <div class="val-desc">Recruiters manually verify your resume credentials, code logic &amp; answers.</div>
        </div>
        <div class="val-card">
          <div class="val-step">Step 3</div>
          <div class="val-icon">&#128197;</div>
          <div class="val-title">Schedule Interview</div>
          <div class="val-desc">Receive confirmation via email to schedule your 1-on-1 technical interview.</div>
        </div>
      </div>

      <!-- CTA -->
      <div class="hero-cta">
        <a href="#auth" class="btn-green">Give Assessment Now &#8594;</a>
        <a href="#auth" class="btn-outline" onclick="switchTab('signup')">&#43; Create Free Account</a>
      </div>

      <!-- TRUST STRIP -->
      <div class="trust-strip">
        <div class="trust-item"><div class="trust-dot"></div>Invited assessment for your job application</div>
        <div class="trust-item"><div class="trust-dot"></div>Manual verification of your resume &amp; answers</div>
        <div class="trust-item"><div class="trust-dot"></div>Interview scheduled via email after review</div>
        <div class="trust-item"><div class="trust-dot"></div>ICUBE Info Solution By Prathmesh Somnath Uchit</div>
        <div class="trust-item"><div class="trust-dot"></div>Contact : 9699925064  Email : prathmeshuchit@gmail.com</div>
      </div>
    </section>

    <!-- AUTH PANEL -->
    <aside class="auth-panel" id="auth">
      <% if (typeof messages !== 'undefined' && messages.error && messages.error.length) { %>
        <div class="alert-msg">&#9888;&#65039; <%= messages.error[0] %></div>
      <% } %>
      <% if (typeof error_msg !== 'undefined' && error_msg && error_msg.length) { %>
        <div class="alert-msg">&#9888;&#65039; <%= error_msg[0] %></div>
      <% } %>
      <% if (typeof success_msg !== 'undefined' && success_msg && success_msg.length) { %>
        <div class="alert-msg" style="background: rgba(34,197,94,0.1); border-color: rgba(34,197,94,0.3); color: #4ade80;">&#9989; <%= success_msg[0] %></div>
      <% } %>

      <div class="auth-tabs">
        <button class="auth-tab active" id="tab-login" onclick="switchTab('login')">Sign In</button>
        <button class="auth-tab" id="tab-signup" onclick="switchTab('signup')">Create Account</button>
      </div>

      <!-- LOGIN -->
      <div class="auth-form active" id="form-login">
        <div class="auth-title">Welcome back &#128075;</div>
        <div class="auth-sub">Sign in to access your invited job assessment.</div>
        <form action="/login" method="POST">
          <input type="hidden" name="loginAs" value="student" />
          <div class="form-group">
            <label class="form-label" for="login-email">Email Address</label>
            <input type="email" class="form-input" id="login-email" name="email" placeholder="you@example.com" required autocomplete="email" />
          </div>
          <div class="form-group">
            <label class="form-label" for="login-password">Password</label>
            <input type="password" class="form-input" id="login-password" name="password" placeholder="&#8226;&#8226;&#8226;&#8226;&#8226;&#8226;&#8226;&#8226;" required autocomplete="current-password" />
          </div>
          <button type="submit" class="btn-submit">Sign In &#8594;</button>
        </form>
        <div class="switch-auth">New candidate? <button class="switch-link" onclick="switchTab('signup')">Create candidate account</button></div>

        <div class="panel-note">
          <strong>&#128203; Job Application Evaluation Process</strong>
          1. Give assessment &bull; 2. Manual verification of resume &amp; answers &bull; 3. Schedule interview
        </div>
      </div>

      <!-- SIGNUP -->
      <div class="auth-form" id="form-signup">
        <div class="auth-title">Join ICUBE Info Solution &#127891;</div>
        <div class="auth-sub">Create your candidate account to access your invited job assessment.</div>
        <form action="/signup" method="POST">
          <div class="form-group">
            <label class="form-label" for="signup-name">Full Name</label>
            <input type="text" class="form-input" id="signup-name" name="name" placeholder="e.g. Priya Sharma" required />
          </div>
          <div class="form-group">
            <label class="form-label" for="signup-email">Email Address</label>
            <input type="email" class="form-input" id="signup-email" name="email" placeholder="you@example.com" required />
          </div>
          <div class="form-group">
            <label class="form-label" for="signup-password">Password</label>
            <input type="password" class="form-input" id="signup-password" name="password" placeholder="Min. 8 characters" required />
          </div>
          <div class="form-group">
            <label class="form-label" for="signup-course">Primary Domain</label>
            <select class="form-select" id="signup-course" name="course">
              <option value="">Select your domain</option>
              <option value="Artificial Intelligence">Artificial Intelligence</option>
              <option value="Data Science">Data Science</option>
              <option value="Robotics">Robotics</option>
              <option value="Machine Learning">Machine Learning</option>
              <option value="MERN Stack">MERN Stack</option>
              <option value="Python Full Stack">Python Full Stack</option>
              <option value="Java Full Stack">Java Full Stack</option>
              <option value="Cloud Computing">Cloud Computing</option>
              <option value="DevOps">DevOps</option>
              <option value="Cybersecurity">Cybersecurity</option>
              <option value="UI/UX Design">UI / UX Design</option>
              <option value="Digital Marketing">Digital Marketing</option>
            </select>
          </div>
          <button type="submit" class="btn-submit">Create Free Account &#8594;</button>
        </form>
        <div class="switch-auth">Already have an account? <button class="switch-link" onclick="switchTab('login')">Sign in</button></div>
      </div>

      <div class="bottom-trust">
        &#128274; Secure &amp; encrypted &nbsp;&#183;&nbsp; No spam ever &nbsp;&#183;&nbsp; Free to register<br/>
        Assessment details (duration, fee, passing %) are shown per exam
      </div>
    </aside>
  </div>

  <script>
    function switchTab(tab) {
      ['login','signup'].forEach(function(t){
        document.getElementById('form-'+t).classList.toggle('active', t===tab);
        document.getElementById('tab-'+t).classList.toggle('active', t===tab);
      });
    }
    if (new URLSearchParams(location.search).get('signup') === '1') switchTab('signup');
  </script>
</body>
</html>
