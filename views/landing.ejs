<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Candidate Assessment &bull; Conducted for Bitzbolt</title>
  <meta name="description" content="Online Technical Examination Portal conducted for Bitzbolt (bitzbolt.online)." />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet" />
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>📝</text></svg>">
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --green: #22c55e;
      --green-glow: rgba(34, 197, 94, 0.35);
      --green-dim: rgba(34, 197, 94, 0.12);
      --bg: #090a0f;
      --bg-card: #12141a;
      --border: rgba(255, 255, 255, 0.08);
      --text: #f1f5f9;
      --muted: #94a3b8;
    }
    body {
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
      background: var(--bg);
      color: var(--text);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      padding: 24px 16px;
      position: relative;
      overflow-x: hidden;
    }
    .bg-radial {
      position: fixed;
      top: -200px;
      left: 50%;
      transform: translateX(-50%);
      width: 700px;
      height: 550px;
      background: radial-gradient(circle, rgba(34, 197, 94, 0.15) 0%, transparent 65%);
      pointer-events: none;
      z-index: 0;
    }
    .exam-wrapper {
      position: relative;
      z-index: 1;
      width: 100%;
      max-width: 460px;
      margin: 0 auto;
    }

    /* HEADER */
    .brand-header {
      text-align: center;
      margin-bottom: 22px;
    }
    .brand-title {
      font-size: 1.45rem;
      font-weight: 800;
      color: #fff;
      display: inline-flex;
      align-items: center;
      gap: 9px;
      letter-spacing: -0.02em;
    }
    .brand-dot {
      width: 10px;
      height: 10px;
      border-radius: 50%;
      background: var(--green);
      box-shadow: 0 0 14px var(--green);
    }
    .conducted-sub {
      margin-top: 8px;
      font-size: 0.86rem;
      color: var(--muted);
      font-weight: 400;
      line-height: 1.5;
    }
    .conducted-sub a {
      color: var(--green);
      text-decoration: underline;
      text-underline-offset: 3px;
      font-weight: 600;
      transition: opacity 0.2s;
    }
    .conducted-sub a:hover {
      opacity: 0.85;
    }

    /* CARD */
    .exam-card {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: 16px;
      padding: 32px 28px;
      box-shadow: 0 20px 45px rgba(0, 0, 0, 0.55), 0 0 35px rgba(34, 197, 94, 0.06);
      position: relative;
      overflow: hidden;
      backdrop-filter: blur(14px);
    }
    .exam-card::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 2px;
      background: linear-gradient(90deg, transparent, var(--green), transparent);
    }

    /* TABS */
    .auth-tabs {
      display: flex;
      background: rgba(255, 255, 255, 0.04);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 4px;
      margin-bottom: 24px;
      gap: 4px;
    }
    .auth-tab {
      flex: 1;
      text-align: center;
      padding: 10px 14px;
      border-radius: 8px;
      font-size: 0.88rem;
      font-weight: 600;
      cursor: pointer;
      color: var(--muted);
      background: transparent;
      border: none;
      transition: all 0.2s ease;
      outline: none;
      font-family: inherit;
    }
    .auth-tab.active {
      background: var(--green);
      color: #000;
      box-shadow: 0 2px 10px var(--green-glow);
    }

    /* FORMS */
    .auth-form {
      display: none;
    }
    .auth-form.active {
      display: block;
      animation: fadeIn 0.25s ease-out;
    }
    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(6px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .form-group {
      margin-bottom: 16px;
    }
    .form-label {
      display: block;
      font-size: 0.76rem;
      font-weight: 700;
      color: var(--muted);
      margin-bottom: 6px;
      letter-spacing: 0.04em;
      text-transform: uppercase;
    }
    .form-input {
      width: 100%;
      padding: 12px 14px;
      background: rgba(255, 255, 255, 0.04);
      border: 1px solid var(--border);
      border-radius: 8px;
      color: #fff;
      font-size: 0.92rem;
      font-family: inherit;
      outline: none;
      transition: border-color 0.2s, box-shadow 0.2s;
    }
    .form-input:focus {
      border-color: var(--green);
      box-shadow: 0 0 0 3px rgba(34, 197, 94, 0.15);
    }
    .form-input::placeholder {
      color: rgba(148, 163, 184, 0.4);
    }
    .form-select {
      width: 100%;
      padding: 12px 14px;
      background: rgba(255, 255, 255, 0.04);
      border: 1px solid var(--border);
      border-radius: 8px;
      color: #fff;
      font-size: 0.92rem;
      font-family: inherit;
      outline: none;
      cursor: pointer;
      transition: border-color 0.2s, box-shadow 0.2s;
    }
    .form-select:focus {
      border-color: var(--green);
      box-shadow: 0 0 0 3px rgba(34, 197, 94, 0.15);
    }
    .form-select option {
      background: #141720;
      color: #fff;
    }

    .btn-submit {
      width: 100%;
      padding: 13px;
      background: var(--green);
      color: #000;
      font-weight: 800;
      font-size: 0.95rem;
      border: none;
      border-radius: 8px;
      cursor: pointer;
      margin-top: 10px;
      transition: all 0.2s ease;
      box-shadow: 0 4px 18px rgba(34, 197, 94, 0.25);
      font-family: inherit;
    }
    .btn-submit:hover {
      background: #16a34a;
      transform: translateY(-1px);
      box-shadow: 0 6px 24px rgba(34, 197, 94, 0.4);
    }

    .switch-auth {
      text-align: center;
      margin-top: 18px;
      font-size: 0.83rem;
      color: var(--muted);
    }
    .switch-link {
      color: var(--green);
      text-decoration: none;
      font-weight: 600;
      cursor: pointer;
      background: none;
      border: none;
      font-size: inherit;
      font-family: inherit;
    }
    .switch-link:hover {
      text-decoration: underline;
    }

    /* ALERTS */
    .alert-box {
      padding: 11px 14px;
      border-radius: 8px;
      font-size: 0.84rem;
      margin-bottom: 18px;
      line-height: 1.45;
    }
    .alert-error {
      background: rgba(239, 68, 68, 0.12);
      border: 1px solid rgba(239, 68, 68, 0.3);
      color: #fca5a5;
    }
    .alert-success {
      background: rgba(34, 197, 94, 0.12);
      border: 1px solid rgba(34, 197, 94, 0.3);
      color: #4ade80;
    }

    /* FOOTER */
    .footer-note {
      margin-top: 22px;
      text-align: center;
      font-size: 0.78rem;
      color: var(--muted);
      opacity: 0.8;
      line-height: 1.6;
    }
    .footer-note a {
      color: var(--green);
      text-decoration: underline;
    }

    .admin-link {
      display: block;
      text-align: center;
      margin-top: 14px;
      font-size: 0.76rem;
      color: rgba(148, 163, 184, 0.6);
      text-decoration: none;
      transition: color 0.2s;
    }
    .admin-link:hover {
      color: var(--green);
      text-decoration: underline;
    }

    @media (max-width: 480px) {
      .exam-card { padding: 24px 18px; }
      body { padding: 18px 12px; }
    }
  </style>
</head>
<body>
  <div class="bg-radial"></div>

  <main class="exam-wrapper" id="auth">
    <!-- Header -->
    <header class="brand-header">
      <div class="brand-title">
        <span class="brand-dot"></span>
        <span>Online Examination</span>
      </div>
      <p class="conducted-sub">
        Conducted for <a href="https://bitzbolt.online" target="_blank" rel="noopener noreferrer">Bitzbolt (bitzbolt.online)</a>
      </p>
    </header>

    <!-- Card -->
    <div class="exam-card">
      <!-- Flash Messages -->
      <% if (typeof messages !== 'undefined' && messages.error && messages.error.length) { %>
        <div class="alert-box alert-error">⚠️ <%= messages.error[0] %></div>
      <% } %>
      <% if (typeof error_msg !== 'undefined' && error_msg && error_msg.length) { %>
        <div class="alert-box alert-error">⚠️ <%= error_msg[0] %></div>
      <% } %>
      <% if (typeof success_msg !== 'undefined' && success_msg && success_msg.length) { %>
        <div class="alert-box alert-success">✅ <%= success_msg[0] %></div>
      <% } %>

      <!-- Auth Switcher Tabs -->
      <nav class="auth-tabs" aria-label="Sign in or Sign up">
        <button type="button" class="auth-tab active" id="tab-login" onclick="switchTab('login')">Sign In</button>
        <button type="button" class="auth-tab" id="tab-signup" onclick="switchTab('signup')">Sign Up</button>
      </nav>

      <!-- 1. SIGN IN FORM -->
      <section class="auth-form active" id="form-login">
        <form action="/login" method="POST">
          <input type="hidden" name="loginAs" value="student" />

          <div class="form-group">
            <label class="form-label" for="login-email">Candidate Email Address</label>
            <input type="email" class="form-input" id="login-email" name="email" placeholder="candidate@example.com" required autocomplete="email" />
          </div>

          <div class="form-group">
            <label class="form-label" for="login-password">Password</label>
            <input type="password" class="form-input" id="login-password" name="password" placeholder="••••••••" required autocomplete="current-password" />
          </div>

          <button type="submit" class="btn-submit">Sign In &bull; Start Exam →</button>
        </form>

        <div class="switch-auth">
          New candidate? <button type="button" class="switch-link" onclick="switchTab('signup')">Create candidate account</button>
        </div>

        <a href="/admin/login" class="admin-link">🔒 Administrator Login →</a>
      </section>

      <!-- 2. SIGN UP FORM -->
      <section class="auth-form" id="form-signup">
        <form action="/signup" method="POST">
          <div class="form-group">
            <label class="form-label" for="signup-name">Full Name</label>
            <input type="text" class="form-input" id="signup-name" name="name" placeholder="e.g. John Doe" required />
          </div>

          <div class="form-group">
            <label class="form-label" for="signup-email">Email Address</label>
            <input type="email" class="form-input" id="signup-email" name="email" placeholder="candidate@example.com" required autocomplete="email" />
          </div>

          <div class="form-group">
            <label class="form-label" for="signup-password">Password</label>
            <input type="password" class="form-input" id="signup-password" name="password" placeholder="Min. 8 characters" required autocomplete="new-password" />
          </div>

          <div class="form-group">
            <label class="form-label" for="signup-course">Examination Track / Domain</label>
            <select class="form-select" id="signup-course" name="course">
              <option value="">Select your track / domain</option>
              <option value="MERN Stack">MERN Stack</option>
              <option value="Python Full Stack">Python Full Stack</option>
              <option value="Java Full Stack">Java Full Stack</option>
              <option value="Data Science">Data Science</option>
              <option value="Artificial Intelligence">Artificial Intelligence</option>
              <option value="Cloud Computing">Cloud Computing</option>
              <option value="DevOps">DevOps</option>
              <option value="UI/UX Design">UI / UX Design</option>
              <option value="Cybersecurity">Cybersecurity</option>
              <option value="General Technical">General Technical</option>
            </select>
          </div>

          <button type="submit" class="btn-submit">Create Account &bull; Start Exam →</button>
        </form>

        <div class="switch-auth">
          Already registered? <button type="button" class="switch-link" onclick="switchTab('login')">Sign in here</button>
        </div>
      </section>
    </div>

    <!-- Footer Note -->
    <footer class="footer-note">
      🔒 Secure Assessment Platform &bull; Conducted for <a href="https://bitzbolt.online" target="_blank" rel="noopener noreferrer">Bitzbolt (bitzbolt.online)</a><br/>
      <a href="/terms" target="_blank">Examination Rules &amp; Terms</a>
    </footer>
  </main>

  <script>
    function switchTab(tab) {
      ['login', 'signup'].forEach(function(t) {
        var form = document.getElementById('form-' + t);
        var btn = document.getElementById('tab-' + t);
        if (form) form.classList.toggle('active', t === tab);
        if (btn) btn.classList.toggle('active', t === tab);
      });
    }

    // Check query params or hash for signup tab
    var params = new URLSearchParams(window.location.search);
    if (params.get('signup') === '1' || window.location.hash === '#signup') {
      switchTab('signup');
    }
  </script>
</body>
</html>
