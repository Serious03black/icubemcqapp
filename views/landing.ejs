<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Candidate Examination Portal &bull; ICUBE World</title>
  <meta name="description"
    content="Official candidate examination and technical assessment portal by ICUBE World (ICUBE Info Solution) for Bitzbolt (bitzbolt.online).">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="icon"
    href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>📝</text></svg>">
  <style>
    *,
    *::before,
    *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    :root {
      --bg: #0d1117;
      --card-bg: #161b22;
      --border: #30363d;
      --border-muted: #21262d;
      --text: #e6edf3;
      --text-muted: #8b949e;
      --green: #238636;
      --green-hover: #2ea043;
      --accent: #58a6ff;
    }

    body {
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      background: var(--bg);
      color: var(--text);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }

    /* TOP NAVBAR */
    .top-nav {
      border-bottom: 1px solid var(--border);
      background: #0d1117;
      padding: 14px 24px;
    }

    .top-nav-inner {
      max-width: 1020px;
      margin: 0 auto;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      flex-wrap: wrap;
    }

    .brand-group {
      display: flex;
      align-items: center;
      gap: 10px;
      text-decoration: none;
      color: #fff;
    }

    .brand-title {
      font-size: 1.15rem;
      font-weight: 700;
      letter-spacing: -0.01em;
    }

    .brand-sub {
      font-size: 0.76rem;
      background: var(--border-muted);
      border: 1px solid var(--border);
      color: var(--text-muted);
      padding: 3px 8px;
      border-radius: 4px;
      font-weight: 500;
    }

    .nav-links {
      display: flex;
      align-items: center;
      gap: 16px;
      font-size: 0.88rem;
    }

    .nav-links a {
      color: var(--text-muted);
      text-decoration: none;
      transition: color 0.15s;
    }

    .nav-links a:hover {
      color: #fff;
    }

    .nav-links .highlight-link {
      color: var(--accent);
      font-weight: 500;
    }

    /* MAIN CONTAINER */
    .main-wrapper {
      flex: 1;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      padding: 36px 16px;
      max-width: 480px;
      margin: 0 auto;
      width: 100%;
    }

    /* CONDUCTED BANNER */
    .partner-tag {
      background: #161b22;
      border: 1px solid var(--border);
      border-radius: 6px;
      padding: 8px 14px;
      font-size: 0.82rem;
      color: var(--text-muted);
      margin-bottom: 16px;
      text-align: center;
      width: 100%;
      line-height: 1.45;
    }

    .partner-tag strong {
      color: #fff;
    }

    .partner-tag a {
      color: var(--accent);
      text-decoration: underline;
      font-weight: 600;
    }

    /* CARD */
    .auth-card {
      background: var(--card-bg);
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 28px 24px;
      width: 100%;
    }

    .card-header {
      margin-bottom: 20px;
    }

    .card-title {
      font-size: 1.25rem;
      font-weight: 700;
      color: #fff;
      margin-bottom: 4px;
    }

    .card-desc {
      font-size: 0.84rem;
      color: var(--text-muted);
    }

    /* TABS */
    .auth-tabs {
      display: grid;
      grid-template-columns: 1fr 1fr;
      border-bottom: 1px solid var(--border);
      margin-bottom: 22px;
    }

    .auth-tab {
      background: transparent;
      border: none;
      border-bottom: 2px solid transparent;
      color: var(--text-muted);
      padding: 10px;
      font-size: 0.9rem;
      font-weight: 600;
      cursor: pointer;
      text-align: center;
      transition: color 0.15s, border-color 0.15s;
      font-family: inherit;
    }

    .auth-tab:hover {
      color: var(--text);
    }

    .auth-tab.active {
      color: #fff;
      border-bottom-color: var(--green);
    }

    /* FORM */
    .auth-form {
      display: none;
    }

    .auth-form.active {
      display: block;
    }

    .form-group {
      margin-bottom: 16px;
    }

    .form-label {
      display: block;
      font-size: 0.82rem;
      font-weight: 600;
      color: var(--text);
      margin-bottom: 6px;
    }

    .form-input {
      width: 100%;
      padding: 10px 12px;
      background: #0d1117;
      border: 1px solid var(--border);
      border-radius: 6px;
      color: #fff;
      font-size: 0.92rem;
      font-family: inherit;
      outline: none;
      transition: border-color 0.15s, box-shadow 0.15s;
    }

    .form-input:focus {
      border-color: var(--accent);
      box-shadow: 0 0 0 3px rgba(88, 166, 255, 0.15);
    }

    .form-input::placeholder {
      color: #6e7681;
    }

    .form-select {
      width: 100%;
      padding: 10px 12px;
      background: #0d1117;
      border: 1px solid var(--border);
      border-radius: 6px;
      color: #fff;
      font-size: 0.92rem;
      font-family: inherit;
      outline: none;
      cursor: pointer;
      transition: border-color 0.15s;
    }

    .form-select:focus {
      border-color: var(--accent);
    }

    .form-select option {
      background: #161b22;
      color: #fff;
    }

    .btn-submit {
      width: 100%;
      padding: 11px;
      background: var(--green);
      color: #fff;
      border: 1px solid rgba(255, 255, 255, 0.1);
      border-radius: 6px;
      font-weight: 600;
      font-size: 0.94rem;
      cursor: pointer;
      margin-top: 8px;
      transition: background 0.15s;
      font-family: inherit;
    }

    .btn-submit:hover {
      background: var(--green-hover);
    }

    .switch-auth {
      margin-top: 16px;
      text-align: center;
      font-size: 0.82rem;
      color: var(--text-muted);
    }

    .switch-link {
      background: none;
      border: none;
      color: var(--accent);
      text-decoration: underline;
      cursor: pointer;
      font-size: inherit;
      font-family: inherit;
      padding: 0;
    }

    /* ALERTS */
    .alert-box {
      padding: 10px 14px;
      border-radius: 6px;
      font-size: 0.84rem;
      margin-bottom: 16px;
      line-height: 1.45;
    }

    .alert-error {
      background: rgba(248, 81, 73, 0.1);
      border: 1px solid rgba(248, 81, 73, 0.4);
      color: #ff7b72;
    }

    .alert-success {
      background: rgba(46, 160, 67, 0.1);
      border: 1px solid rgba(46, 160, 67, 0.4);
      color: #3fb950;
    }

    /* FOOTER */
    .site-footer {
      border-top: 1px solid var(--border);
      background: #0d1117;
      padding: 20px 16px;
      text-align: center;
      font-size: 0.8rem;
      color: var(--text-muted);
    }

    .footer-links {
      margin-top: 6px;
    }

    .footer-links a {
      color: var(--text-muted);
      text-decoration: underline;
      margin: 0 8px;
    }

    .footer-links a:hover {
      color: #fff;
    }
  </style>
</head>

<body>

  <!-- Top Navbar -->
  <header class="top-nav">
    <div class="top-nav-inner">
      <a href="/" class="brand-group">
        <span class="brand-title">ICUBE World</span>
        <span class="brand-sub">ICUBE Info Solution</span>
      </a>
      <nav class="nav-links">
        <a href="/about" class="highlight-link">About Us</a>
        <a href="/terms">Rules &amp; Terms</a>
        <a href="https://bitzbolt.online" target="_blank" rel="noopener noreferrer">bitzbolt.online ↗</a>
        <a href="/admin/login">Admin</a>
      </nav>
    </div>
  </header>

  <!-- Main Body -->
  <main class="main-wrapper" id="auth">
    <!-- Partner Tag -->
    <div class="partner-tag">
      Assessment Partner: <a href="https://bitzbolt.online" target="_blank" rel="noopener noreferrer">Bitzbolt
        (bitzbolt.online)</a> &bull; Examination Authority: <strong>ICUBE World</strong>
    </div>

    <!-- Auth Card -->
    <div class="auth-card">
      <div class="card-header">
        <h1 class="card-title">Candidate Assessment Portal</h1>
        <p class="card-desc">Sign in or register to take your technical assessment.</p>
      </div>

      <!-- Flash Alerts -->
      <% if (typeof messages !=='undefined' && messages.error && messages.error.length) { %>
        <div class="alert-box alert-error">
          <%= messages.error[0] %>
        </div>
        <% } %>
          <% if (typeof error_msg !=='undefined' && error_msg && error_msg.length) { %>
            <div class="alert-box alert-error">
              <%= error_msg[0] %>
            </div>
            <% } %>
              <% if (typeof success_msg !=='undefined' && success_msg && success_msg.length) { %>
                <div class="alert-box alert-success">
                  <%= success_msg[0] %>
                </div>
                <% } %>

                  <!-- Tabs -->
                  <div class="auth-tabs">
                    <button type="button" class="auth-tab active" id="tab-login" onclick="switchTab('login')">Sign
                      In</button>
                    <button type="button" class="auth-tab" id="tab-signup" onclick="switchTab('signup')">Create
                      Account</button>
                  </div>

                  <!-- 1. SIGN IN FORM -->
                  <section class="auth-form active" id="form-login">
                    <form action="/login" method="POST">
                      <input type="hidden" name="loginAs" value="student" />

                      <div class="form-group">
                        <label class="form-label" for="login-email">Email Address</label>
                        <input type="email" class="form-input" id="login-email" name="email"
                          placeholder="name@example.com" required autocomplete="email" />
                      </div>

                      <div class="form-group">
                        <label class="form-label" for="login-password">Password</label>
                        <input type="password" class="form-input" id="login-password" name="password"
                          placeholder="••••••••" required autocomplete="current-password" />
                      </div>

                      <button type="submit" class="btn-submit">Sign In to Examination →</button>
                    </form>

                    <div class="switch-auth">
                      New candidate? <button type="button" class="switch-link" onclick="switchTab('signup')">Create
                        candidate account</button>
                    </div>
                  </section>

                  <!-- 2. CREATE ACCOUNT FORM -->
                  <section class="auth-form" id="form-signup">
                    <form action="/signup" method="POST">
                      <div class="form-group">
                        <label class="form-label" for="signup-name">Full Name</label>
                        <input type="text" class="form-input" id="signup-name" name="name" placeholder="Candidate Name"
                          required />
                      </div>

                      <div class="form-group">
                        <label class="form-label" for="signup-email">Email Address</label>
                        <input type="email" class="form-input" id="signup-email" name="email"
                          placeholder="name@example.com" required autocomplete="email" />
                      </div>

                      <div class="form-group">
                        <label class="form-label" for="signup-password">Password</label>
                        <input type="password" class="form-input" id="signup-password" name="password"
                          placeholder="Min. 8 characters" required autocomplete="new-password" />
                      </div>

                      <!-- Reference ID & Autofilled Company Name -->
                      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 16px;">
                        <div>
                          <label class="form-label" for="signup-refid">Company Reference ID</label>
                          <input type="text" class="form-input" id="signup-refid" name="refId" placeholder="e.g.  "
                            autocomplete="off" />
                          <small
                            style="font-size: 0.72rem; color: var(--text-muted); display: block; margin-top: 4px;">Enter
                            company ref code</small>
                        </div>
                        <div>
                          <label class="form-label" for="signup-company">Company Name</label>
                          <input type="text" class="form-input" id="signup-company" name="company"
                            placeholder="Autofills with ref ID" readonly
                            style="background: rgba(255,255,255,0.02); cursor: not-allowed; color: #58a6ff; font-weight: 600;" />
                          <small id="company-status-badge"
                            style="font-size: 0.72rem; color: #3fb950; display: none; margin-top: 4px;">✓ Verified
                            Partner</small>
                        </div>
                      </div>

                      <div class="form-group">
                        <label class="form-label" for="signup-course">Examination Track / Domain</label>
                        <select class="form-select" id="signup-course" name="course">
                          <option value="">Select your track</option>
                          <option value="MERN Stack">MERN Stack</option>
                          <option value="Python Full Stack">Python Full Stack</option>
                          <option value="Java Full Stack">Java Full Stack</option>
                          <option value="Data Science">Data Science</option>
                          <option value="Artificial Intelligence">Artificial Intelligence</option>
                          <option value="Cloud Computing">Cloud Computing</option>
                          <option value="DevOps">DevOps</option>
                          <option value="UI/UX Design">UI / UX Design</option>
                          <option value="Cybersecurity">Cybersecurity</option>
                          <option value="General Technical">General Technical</option>
                        </select>
                      </div>

                      <button type="submit" class="btn-submit">Create Account &bull; Start Exam →</button>
                    </form>

                    <div class="switch-auth">
                      Already registered? <button type="button" class="switch-link" onclick="switchTab('login')">Sign in
                        here</button>
                    </div>
                  </section>
    </div>
  </main>

  <!-- Footer -->
  <footer class="site-footer">
    <div>
      <strong>ICUBE World</strong> (ICUBE Info Solution) &bull; Technical Examination Authority
    </div>
    <div class="footer-links">
      Assessments for <a href="https://bitzbolt.online" target="_blank" rel="noopener noreferrer">Bitzbolt
        (bitzbolt.online)</a> |
      <a href="/about">About Us</a> |
      <a href="/terms">Examination Rules</a> |
      <a href="/admin/login">Admin Portal</a>
    </div>
  </footer>

  <script>
    function switchTab(tab) {
      ['login', 'signup'].forEach(function (t) {
        var form = document.getElementById('form-' + t);
        var btn = document.getElementById('tab-' + t);
        if (form) form.classList.toggle('active', t === tab);
        if (btn) btn.classList.toggle('active', t === tab);
      });
    }

    var params = new URLSearchParams(window.location.search);
    if (params.get('signup') === '1' || window.location.hash === '#signup') {
      switchTab('signup');
    }

    // Reference ID Autofill for Company
    var refIdInput = document.getElementById('signup-refid');
    var companyInput = document.getElementById('signup-company');
    var statusBadge = document.getElementById('company-status-badge');

    function checkRefId() {
      if (!refIdInput || !companyInput) return;
      var val = refIdInput.value.trim();
      var upper = val.toUpperCase();
      if (upper === ' ' || upper.indexOf('BIT') === 0) {
        companyInput.value = 'Bitzbolt';
        if (statusBadge) statusBadge.style.display = 'block';
      } else if (val.length === 0) {
        companyInput.value = '';
        if (statusBadge) statusBadge.style.display = 'none';
      } else {
        companyInput.value = val;
        if (statusBadge) statusBadge.style.display = 'none';
      }
    }

    if (refIdInput) {
      refIdInput.addEventListener('input', checkRefId);
      refIdInput.addEventListener('change', checkRefId);
      refIdInput.addEventListener('paste', function () { setTimeout(checkRefId, 40); });
      checkRefId();
    }
  </script>
</body>

</html>