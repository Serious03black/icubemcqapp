<%- include('../partials/header') %>

<div class="profile-header" style="display:flex; justify-content:space-between; align-items:center; padding:16px 24px; background: rgba(15,23,42,0.9); border-bottom: 1px solid rgba(129,140,248,0.15); backdrop-filter: blur(8px);">
  <div class="welcome-msg" style="color:#e2e8f0; font-size:1.2rem; font-weight:600;">
    Welcome, <%= currentUser.name %>!
  </div>
<a href="/student/profile" class="profile-link" style="display:flex; align-items:center; gap:12px; color:#a5b4fc; text-decoration:none;">
  <span class="profile-icon" style="width:32px; height:32px; background:#818cf8; color:#fff; display:flex; align-items:center; justify-content:center; border-radius:8px; font-weight:700;">
    <%= currentUser.name.charAt(0).toUpperCase() %>
  </span>
  Profile
</a>
</div>

<!-- Existing dashboard layout -->
<div class="dashboard-layout" style="margin-top:0;">


    <div class="page-body">
      <%- include('../partials/alerts') %>

      <!-- Stats -->
      <div class="stats-grid">
        <div class="stat-card">
          <div class="stat-icon purple">📋</div>
          <div class="stat-value"><%= totalAssigned %></div>
          <div class="stat-label">Assigned Tests</div>
        </div>
        <div class="stat-card">
          <div class="stat-icon orange">⏳</div>
          <div class="stat-value"><%= totalPending %></div>
          <div class="stat-label">Pending Tests</div>
        </div>
        <div class="stat-card">
          <div class="stat-icon green">✅</div>
          <div class="stat-value"><%= totalCompleted %></div>
          <div class="stat-label">Completed Tests</div>
        </div>
      </div>

      <!-- Pending Tests -->
      <div class="card" style="margin-bottom: 24px;">
        <div class="card-header">
          <h3>⏳ Pending Tests</h3>
        </div>
        <div class="card-body">
          <% if (pendingTests.length === 0) { %>
            <div class="empty-state">
              <span class="empty-icon">🎉</span>
              <h3>All caught up!</h3>
              <p>You have no pending tests. Check back later for new assignments.</p>
            </div>
          <% } else { %>
            <div class="test-grid">
              <% pendingTests.forEach(test => { %>
                <div class="test-card">
                  <div class="test-card-header">
                    <div class="test-card-title"><%= test.title %></div>
                    <span class="badge badge-success">Active</span>
                  </div>
                  <% if (test.description) { %>
                    <p style="font-size: 0.85rem; color: var(--text-muted); margin-bottom: 12px;">
                      <%= test.description.substring(0, 100) %><%= test.description.length > 100 ? '...' : '' %>
                    </p>
                  <% } %>
                  <div class="test-card-meta">
                    <span>📚 <%= test.course %></span>
                    <span>❓ <%= test.questions.length %> Questions</span>
                    <span>⏱️ <%= test.duration %> mins</span>
                    <span>🏆 <%= test.totalMarks %> marks</span>
                  </div>
                  <div class="test-card-actions">
                    <a href="/student/test/<%= test._id %>" class="btn btn-primary">▶️ Start Test</a>
                  </div>
                </div>
              <% }) %>
            </div>
          <% } %>
        </div>
      </div>

      <!-- Completed Tests -->
      <div class="card">
        <div class="card-header">
          <h3>✅ Completed Tests</h3>
        </div>
        <div class="card-body">
          <% if (completedResults.length === 0) { %>
            <div class="empty-state">
              <span class="empty-icon">📝</span>
              <h3>No completed tests yet</h3>
              <p>Your completed tests will appear here.</p>
            </div>
          <% } else { %>
            <div class="test-grid">
              <% completedResults.forEach(result => { %>
                <div class="test-card" style="opacity:0.75;">
                  <div class="test-card-header">
                    <div class="test-card-title"><%= result.test ? result.test.title : 'Deleted Test' %></div>
                    <span class="badge badge-info">Completed</span>
                  </div>
                  <div class="test-card-meta">
                    <span>📚 <%= result.test ? result.test.course : 'N/A' %></span>
                    <span>📅 <%= new Date(result.submittedAt).toLocaleDateString('en-IN') %></span>
                  </div>
                </div>
              <% }) %>
            </div>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
