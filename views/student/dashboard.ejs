<%- include('../partials/header') %>

<div class="dashboard-layout">
  <%- include('../partials/student-sidebar', { active: 'dashboard' }) %>

  <div class="main-content">
    <div class="page-header">
      <div class="page-header-actions">
        <div>
          <h1>Candidate Dashboard</h1>
          <p>Welcome back, <%= currentUser.name %>! Manage your technical evaluations and assessment progress.</p>
        </div>
        <a href="/student/profile" class="profile-link">
          <span class="profile-icon">
            <%= currentUser.name.charAt(0).toUpperCase() %>
          </span>
          <span>Profile (<%= currentUser.course || 'Candidate' %>)</span>
        </a>
      </div>
    </div>

    <div class="page-body">
      <%- include('../partials/alerts') %>

      <!-- Hiring Pipeline Banner matching Landing Page -->
      <div style="background: linear-gradient(135deg, rgba(34,197,94,.16), rgba(34,197,94,.04)); border: 1px solid rgba(34,197,94,.32); border-radius: 12px; padding: 14px 18px; margin-bottom: 24px; display: flex; align-items: center; justify-content: space-between; gap: 14px; flex-wrap: wrap;">
        <div style="display: flex; align-items: center; gap: 12px; flex-wrap: wrap;">
          <span style="background: var(--green); color: #000; font-weight: 800; font-size: .72rem; letter-spacing: .06em; text-transform: uppercase; padding: 5px 11px; border-radius: 6px; white-space: nowrap; display: inline-flex; align-items: center; gap: 6px;">
            🤝 Exam Pro Assessment Status
          </span>
          <div style="font-size: .86rem; color: #e2e8f0; line-height: 1.45;">
            <strong>Pre-Interview Technical Evaluation:</strong> Conducted by <strong>Exam Pro</strong>. Complete your assigned assessments. <em>Note: Passing marks do not guarantee an interview; qualification strictly requires optimized, high-quality code as manually reviewed by our recruiters.</em>
          </div>
        </div>
        <a href="/terms" target="_blank" style="color: var(--green); font-size: 0.82rem; font-weight: 700; text-decoration: underline;">
          Exam Pro Rules &amp; T&amp;C ↗
        </a>
      </div>

      <!-- Stats Grid -->
      <div class="stats-grid">
        <div class="stat-card">
          <div class="stat-icon green">📋</div>
          <div class="stat-value"><%= totalAssigned %></div>
          <div class="stat-label">Available Assessments</div>
        </div>
        <div class="stat-card">
          <div class="stat-icon orange">⏳</div>
          <div class="stat-value"><%= totalPending %></div>
          <div class="stat-label">To Attempt</div>
        </div>
        <div class="stat-card">
          <div class="stat-icon green">✅</div>
          <div class="stat-value"><%= totalCompleted %></div>
          <div class="stat-label">Completed Tests</div>
        </div>
      </div>

      <!-- Available Tests Section -->
      <div class="card" style="margin-bottom: 26px;">
        <div class="card-header">
          <h3>📋 Available Assessments</h3>
          <span class="badge badge-success"><%= totalPending %> Available</span>
        </div>
        <div class="card-body">
          <% if (pendingTests.length === 0) { %>
            <div class="empty-state">
              <span class="empty-icon">🎉</span>
              <h3>All caught up!</h3>
              <p>You have no pending tests. Check back later for new assignments or notifications.</p>
            </div>
          <% } else { %>
            <div class="test-grid">
              <% pendingTests.forEach(test => { %>
                <div class="test-card">
                  <div class="test-card-header">
                    <div class="test-card-title"><%= test.title %></div>
                    <span class="badge badge-success">Active</span>
                  </div>
                  <% if (test.description) { %>
                    <p style="font-size: 0.85rem; color: var(--text-muted); margin-bottom: 14px; line-height: 1.5;">
                      <%= test.description.substring(0, 110) %><%= test.description.length > 110 ? '...' : '' %>
                    </p>
                  <% } %>
                  <div class="test-card-meta">
                    <span>📚 <%= test.course %></span>
                    <span>
                      💰
                      <% if (test.originalPrice && test.originalPrice > test.price) { %>
                        <span style="text-decoration: line-through; color: var(--text-muted); opacity: 0.65; margin-right: 4px;">₹<%= test.originalPrice %></span>
                      <% } %>
                      <strong style="color: var(--green);"><%= (test.price && test.price > 0) ? '₹' + test.price : 'Free' %></strong>
                    </span>
                    <span>❓ <%= test.questions ? test.questions.length : 0 %> Questions</span>
                    <span>⏱️ <%= test.duration %> mins</span>
                    <span>🏆 <%= test.totalMarks %> marks</span>
                  </div>
                  <div class="test-card-actions">
                    <a href="/student/test/<%= test._id %>" class="btn btn-primary btn-full">
                      ▶️ Start Assessment
                    </a>
                  </div>
                </div>
              <% }) %>
            </div>
          <% } %>
        </div>
      </div>

      <!-- Completed Tests Section -->
      <div class="card">
        <div class="card-header">
          <h3>✅ Completed Assessments</h3>
          <span class="badge badge-info"><%= totalCompleted %> Finished</span>
        </div>
        <div class="card-body">
          <% if (completedResults.length === 0) { %>
            <div class="empty-state">
              <span class="empty-icon">📝</span>
              <h3>No completed tests yet</h3>
              <p>Your finished assessments and submission records will appear here.</p>
            </div>
          <% } else { %>
            <div class="test-grid">
              <% completedResults.forEach(result => { %>
                <div class="test-card" style="opacity: 0.88;">
                  <div class="test-card-header">
                    <div class="test-card-title"><%= result.test ? result.test.title : 'Assessment' %></div>
                    <span class="badge badge-info">Submitted</span>
                  </div>
                  <div class="test-card-meta">
                    <span>📚 <%= result.test ? result.test.course : 'Technical Evaluation' %></span>
                    <span>📅 <%= new Date(result.submittedAt).toLocaleDateString('en-IN') %></span>
                    <span>🔍 Verification in progress</span>
                  </div>
                </div>
              <% }) %>
            </div>
          <% } %>
        </div>
      </div>

    </div>
  </div>
</div>

<%- include('../partials/footer') %>
