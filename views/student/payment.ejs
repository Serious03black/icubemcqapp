<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %></title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet" />
  <style>
    body {
      margin: 0;
      font-family: 'Inter', sans-serif;
      background: linear-gradient(135deg, #1e293b, #0f172a);
      color: #e2e8f0;
      display: flex;
      justify-content: center;
      align-items: center;
      min-height: 100vh;
    }
    .card {
      background: rgba(30, 41, 59, 0.85);
      padding: 2rem;
      border-radius: 12px;
      box-shadow: 0 8px 32px rgba(0, 0, 0, 0.2);
      backdrop-filter: blur(8px);
      max-width: 500px;
      width: 100%;
    }
    .btn {
      background: #6366f1;
      color: #fff;
      padding: 0.75rem 1.5rem;
      border: none;
      border-radius: 8px;
      cursor: pointer;
      font-weight: 600;
      width: 100%;
    }
    .btn:hover {
      background: #4f46e5;
    }
  </style>
</head>
<body>
  <div class="card">
    <h2>Pay for <%= test.title %></h2>
    <p>Price: <strong>₹<%= test.price %></strong></p>
    <form id="payment-form">
      <button type="button" id="pay-button" class="btn">Pay with Razorpay</button>
    </form>
  </div>
  <script src="https://checkout.razorpay.com/v1/checkout.js"></script>
  <script>
    const razorpayKey = "<%= razorpayKey %>";
    const orderOptions = {
      key: razorpayKey,
      amount: <%= test.price %> * 100, // amount in paise
      currency: "INR",
      name: "TechMinds MCQ",
      description: `Payment for ${"<%= test.title %>"}`,
      handler: function (response) {
        // Post verification to server
        fetch(`/student/pay/${"<%= test._id %>"}`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(response)
        })
        .then(() => { window.location.href = `/student/test/${"<%= test._id %>"}`; })
        .catch(err => console.error(err));
      },
      prefill: {
        email: "<%= currentUser ? currentUser.email : '' %>",
        name: "<%= currentUser ? currentUser.name : '' %>"
      },
      theme: { color: "#6366f1" }
    };
    document.getElementById('pay-button').onclick = function (e) {
      const rzp = new Razorpay(orderOptions);
      rzp.open();
      e.preventDefault();
    };
  </script>
</body>
</html>
