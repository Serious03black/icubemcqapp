<%- include('../partials/header') %>

<div class="login-page">
  <div class="login-bg"></div>
  <div class="login-container">
    <div class="login-card">
      <div class="login-brand">
        <div class="brand" style="justify-content: center; margin-bottom: 8px;">
          <div class="brand-dot"></div>
          ICUBE <span>Info Solution</span>
        </div>
        <div class="portal-badge" style="margin: 0 auto 16px; display: inline-block;">
          ICUBE World Secure Assessment Checkout
        </div>
        <h1>Assessment Access Fee</h1>
        <p style="color: var(--text-muted); font-size: 0.86rem; margin-top: 4px;">
          Complete payment to unlock your technical examination
        </p>
      </div>

      <!-- Test Summary Card -->
      <div style="background: rgba(255,255,255,0.03); border: 1px solid var(--border); border-radius: 12px; padding: 20px; margin-bottom: 22px;">
        <div style="font-size: 0.74rem; color: var(--green); font-weight: 800; text-transform: uppercase; letter-spacing: 0.06em; margin-bottom: 4px;">
          ⚡ ICUBE World (ICUBE Info Solution)
        </div>
        <div style="font-size: 1.1rem; font-weight: 800; color: #fff; margin-bottom: 6px;"><%= test.title %></div>
        <div style="font-size: 0.82rem; color: var(--green); font-weight: 700; margin-bottom: 12px; text-transform: uppercase; letter-spacing: 0.05em;"><%= test.course %></div>
        <div style="display: flex; justify-content: space-between; align-items: center; border-top: 1px solid var(--border); padding-top: 14px;">
          <div>
            <div style="font-size: 0.88rem; color: var(--text-muted);">Assessment Fee</div>
            <% if (test.originalPrice && test.originalPrice > test.price) { %>
              <div style="font-size: 0.74rem; color: var(--green); font-weight: 700; margin-top: 2px;">
                🎉 Special Offer Applied (<%= Math.round(((test.originalPrice - test.price) / test.originalPrice) * 100) %>% OFF)
              </div>
            <% } %>
          </div>
          <div style="display: flex; align-items: baseline; gap: 8px;">
            <% if (test.originalPrice && test.originalPrice > test.price) { %>
              <span style="font-size: 1.05rem; text-decoration: line-through; color: var(--text-muted); opacity: 0.65;">
                ₹<%= test.originalPrice %>
              </span>
            <% } %>
            <span style="font-size: 1.55rem; font-weight: 900; color: #fff;">
              ₹<%= test.price %>
            </span>
          </div>
        </div>
      </div>

      <!-- Pay Button -->
      <button type="button" id="pay-button" class="btn btn-primary btn-lg btn-full">
        💳 Pay ₹<%= test.price %> with Cashfree →
      </button>

      <!-- Error display -->
      <div id="pay-error" style="display:none; margin-top: 14px; padding: 12px 16px; background: rgba(239,68,68,0.12); border: 1px solid rgba(239,68,68,0.3); border-radius: 8px; color: #f87171; font-size: 0.85rem;"></div>

      <div style="text-align: center; margin-top: 18px; font-size: 0.78rem; color: var(--text-muted);">
        🔒 256-Bit SSL Encrypted &bull; ICUBE World (ICUBE Info Solution) &bull; <a href="/terms" target="_blank" style="color: var(--green); text-decoration: underline;">Examination Terms &amp; Refund Policy</a>
      </div>
      <div style="text-align: center; margin-top: 12px; font-size: 0.84rem;">
        <a href="/student/dashboard" style="color: var(--text-muted);">← Return to Dashboard</a>
      </div>
    </div>
  </div>
</div>

<script src="https://sdk.cashfree.com/js/v3/cashfree.js"></script>
<script>
  const TEST_ID  = '<%= test._id %>';
  const CF_MODE  = '<%= cashfreeMode || "production" %>';
  const AMOUNT   = <%= test.price %>;

  const cashfree = Cashfree({ mode: CF_MODE });

  function showError(msg) {
    const el = document.getElementById('pay-error');
    el.textContent = '⚠️ ' + msg;
    el.style.display = 'block';
    const btn = document.getElementById('pay-button');
    btn.disabled = false;
    btn.textContent = '💳 Try Again';
  }

  document.getElementById('pay-button').onclick = async function () {
    this.disabled = true;
    this.textContent = 'Initializing Cashfree payment…';
    document.getElementById('pay-error').style.display = 'none';

    try {
      // Step 1: Create Cashfree order on server
      const orderRes = await fetch(`/student/pay/${TEST_ID}/order`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' }
      });
      const orderData = await orderRes.json();
      if (!orderRes.ok) throw new Error(orderData.error || 'Failed to initialize payment order');

      if (!orderData.paymentSessionId) {
        throw new Error('Cashfree payment session was not generated.');
      }

      this.textContent = 'Opening Cashfree Checkout…';

      // Step 2: Open Cashfree checkout modal
      const checkoutOptions = {
        paymentSessionId: orderData.paymentSessionId,
        redirectTarget: "_modal"
      };

      cashfree.checkout(checkoutOptions).then(async function (result) {
        if (result.error) {
          showError(result.error.message || 'Payment cancelled or failed. Please try again.');
          return;
        }

        if (result.redirect) {
          // Cashfree handles redirection
          return;
        }

        // Modal closed or completed -> verify payment status on server
        document.getElementById('pay-button').textContent = 'Verifying payment…';
        try {
          const verifyRes = await fetch(`/student/pay/${TEST_ID}/verify`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ orderId: orderData.orderId })
          });
          const verifyData = await verifyRes.json();

          if (verifyRes.ok && verifyData.success) {
            window.location.href = verifyData.redirect;
          } else {
            showError(verifyData.error || 'Payment verification failed. Please contact support.');
          }
        } catch (vErr) {
          showError('Verification error. If money was deducted, contact support with Order ID: ' + orderData.orderId);
        }
      });
    } catch (err) {
      showError(err.message || 'Something went wrong. Please refresh and try again.');
    }
  };
</script>

<%- include('../partials/footer') %>
