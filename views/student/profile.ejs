<%- include('../partials/header') %>

<div class="dashboard-layout">
  <%- include('../partials/student-sidebar', { active: 'profile' }) %>

  <div class="main-content">
    <div class="page-header">
      <div class="page-header-actions">
        <div>
          <h1>Candidate Profile</h1>
          <p>Your candidate information and registered evaluation track</p>
        </div>
        <a href="/student/dashboard" class="btn btn-outline">← Back to Dashboard</a>
      </div>
    </div>

    <div class="page-body">
      <%- include('../partials/alerts') %>

      <div class="card" style="max-width: 680px;">
        <div class="card-header">
          <h3>👤 Candidate Details</h3>
          <span class="badge badge-success">Active Candidate</span>
        </div>
        <div class="card-body">
          <div style="display: flex; align-items: center; gap: 18px; margin-bottom: 24px; padding-bottom: 20px; border-bottom: 1px solid var(--border);">
            <div style="width: 64px; height: 64px; border-radius: 50%; background: var(--green); color: #000; font-size: 1.6rem; font-weight: 800; display: flex; align-items: center; justify-content: center; box-shadow: 0 0 20px rgba(34,197,94,0.3);">
              <%= currentUser.name.charAt(0).toUpperCase() %>
            </div>
            <div>
              <h2 style="font-size: 1.3rem; font-weight: 800; color: #fff; margin-bottom: 4px;"><%= currentUser.name %></h2>
              <p style="color: var(--text-muted); font-size: 0.88rem;"><%= currentUser.email %></p>
            </div>
          </div>

          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 18px; margin-bottom: 24px;">
            <div style="background: rgba(255,255,255,0.03); border: 1px solid var(--border); border-radius: 10px; padding: 14px 16px;">
              <div style="font-size: 0.72rem; font-weight: 700; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 4px;">Primary Track</div>
              <div style="font-size: 1rem; font-weight: 700; color: var(--green);"><%= currentUser.course || 'General Tech' %></div>
            </div>
            <div style="background: rgba(255,255,255,0.03); border: 1px solid var(--border); border-radius: 10px; padding: 14px 16px;">
              <div style="font-size: 0.72rem; font-weight: 700; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 4px;">Account Role</div>
              <div style="font-size: 1rem; font-weight: 700; color: #fff;">Invited Candidate</div>
            </div>
          </div>

          <div style="background: var(--green-dim); border: 1px solid rgba(34,197,94,0.25); border-radius: 10px; padding: 14px 16px; font-size: 0.85rem; color: #e2e8f0; line-height: 1.5; margin-bottom: 24px;">
            <strong style="color: var(--green); display: block; margin-bottom: 4px;">📋 Hiring &amp; Evaluation Flow</strong>
            After you submit your assigned test, our recruitment team will manually verify your resume credentials and submitted test answers before sending you the interview schedule.
          </div>

          <div style="display: flex; gap: 12px;">
            <a href="/student/dashboard" class="btn btn-primary">Go to Assessments →</a>
            <a href="/logout" class="btn btn-outline">Sign Out</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
