<%- include('../partials/header') %>

<style>
  /* ── Test header bar ── */
  .test-topbar {
    position: sticky; top: 0; z-index: 100;
    display: flex; align-items: center; justify-content: space-between;
    background: rgba(15, 15, 15, 0.95);
    border-bottom: 1px solid var(--border);
    padding: 14px 28px;
    backdrop-filter: blur(14px);
  }
  .test-topbar .test-info { display: flex; align-items: center; gap: 14px; }
  .test-topbar .test-info h2 { font-size: 1.1rem; font-weight: 800; color: #fff; margin: 0; }
  .test-topbar .test-info p  { font-size: 0.8rem; color: var(--text-muted); margin: 2px 0 0; }

  .test-progress { display: flex; align-items: center; gap: 10px; }
  .test-progress span { font-size: 0.84rem; color: var(--text-muted); font-weight: 600; }
  .progress-bar { width: 140px; height: 7px; background: rgba(255,255,255,0.08); border-radius: 99px; overflow: hidden; }
  .progress-fill { height: 100%; background: linear-gradient(90deg, #22c55e, #16a34a); border-radius: 99px; transition: width 0.3s; }

  .test-timer {
    display: flex; align-items: center; gap: 8px;
    background: var(--green-dim); border: 1px solid rgba(34,197,94,0.3);
    padding: 8px 16px; border-radius: 8px; font-weight: 800; font-size: 1.15rem; color: #fff;
    font-family: 'JetBrains Mono', monospace;
  }
  .test-timer.warning { background: rgba(245,158,11,0.14); border-color: rgba(245,158,11,0.4); color: #fbbf24; }
  .test-timer.danger  { background: rgba(239,68,68,0.18);  border-color: rgba(239,68,68,0.4);  color: #f87171; animation: pulse 1s infinite; }
  @keyframes pulse { 0%,100%{opacity:1} 50%{opacity:0.6} }

  /* ── Sub-test tab bar ── */
  .section-tabs {
    display: flex; gap: 4px; overflow-x: auto;
    background: rgba(10, 10, 10, 0.95);
    border-bottom: 1px solid var(--border);
    padding: 8px 24px 0;
    position: sticky; top: 68px; z-index: 99;
    backdrop-filter: blur(12px);
  }
  .section-tab {
    padding: 10px 18px; cursor: pointer;
    font-size: 0.86rem; font-weight: 600;
    color: var(--text-muted); border-bottom: 2px solid transparent;
    white-space: nowrap; transition: all 0.2s;
    display: flex; align-items: center; gap: 8px;
    border-radius: 6px 6px 0 0;
  }
  .section-tab:hover { color: #fff; background: rgba(255, 255, 255, 0.03); }
  .section-tab.active {
    color: var(--green); border-bottom-color: var(--green);
    background: var(--green-dim); font-weight: 700;
  }
  .section-tab .tab-badge {
    font-size: 0.68rem; background: rgba(255, 255, 255, 0.08);
    color: #e2e8f0; padding: 2px 7px; border-radius: 99px;
  }
  .section-tab .tab-type {
    font-size: 0.62rem; padding: 2px 6px; border-radius: 4px; font-weight: 800; text-transform: uppercase;
  }
  .tab-type.mcq   { background: var(--green-dim); color: var(--green); border: 1px solid rgba(34,197,94,0.3); }
  .tab-type.code  { background: rgba(245,158,11,0.15); color: #fbbf24; border: 1px solid rgba(245,158,11,0.3); }
  .tab-type.mixed { background: rgba(56,189,248,0.15); color: #38bdf8; border: 1px solid rgba(56,189,248,0.3); }

  /* ── Section panels ── */
  .section-panel { display: none; padding: 32px 24px; max-width: 860px; margin: 0 auto; }
  .section-panel.active { display: block; }

  /* ── Question card ── */
  .question-card {
    background: var(--bg-card); border: 1px solid var(--border);
    border-radius: 12px; padding: 22px; margin-bottom: 18px;
    transition: border-color 0.2s, box-shadow 0.2s;
  }
  .question-card:hover { border-color: rgba(34, 197, 94, 0.3); }
  .question-header { display: flex; align-items: flex-start; gap: 14px; margin-bottom: 18px; }
  .question-number {
    min-width: 32px; height: 32px; display: flex; align-items: center; justify-content: center;
    background: var(--green); color: #000;
    font-weight: 800; font-size: 0.85rem; border-radius: 8px; flex-shrink: 0;
  }
  .question-text { color: #fff; font-weight: 600; font-size: 0.96rem; line-height: 1.5; flex: 1; }
  .question-marks { font-size: 0.74rem; color: var(--text-muted); background: rgba(255,255,255,0.05); padding: 4px 10px; border-radius: 6px; white-space: nowrap; border: 1px solid var(--border); }

  /* ── MCQ options ── */
  .mcq-options { display: grid; gap: 10px; }
  .mcq-option { display: none; }
  .mcq-label {
    display: flex; align-items: center; gap: 12px; padding: 13px 16px;
    background: rgba(255,255,255,0.03); border: 1px solid var(--border);
    border-radius: 8px; cursor: pointer; transition: all 0.2s;
    font-size: 0.88rem; color: var(--text-secondary);
  }
  .mcq-label:hover { background: rgba(34, 197, 94, 0.05); border-color: rgba(34, 197, 94, 0.35); }
  .mcq-option:checked + .mcq-label {
    background: var(--green-dim); border-color: var(--green); color: #fff;
    box-shadow: 0 0 0 2px rgba(34, 197, 94, 0.2);
  }
  .mcq-marker {
    min-width: 28px; height: 28px; display: flex; align-items: center; justify-content: center;
    background: rgba(255,255,255,0.06); border-radius: 6px; font-weight: 700; font-size: 0.78rem; color: var(--green);
  }
  .mcq-option:checked + .mcq-label .mcq-marker {
    background: var(--green); color: #000;
  }

  /* ── Code textarea ── */
  .code-answer-area {
    width: 100%; min-height: 160px; padding: 14px;
    background: rgba(0, 0, 0, 0.4); border: 1px solid var(--border);
    border-radius: 8px; color: #fff; font-family: 'JetBrains Mono', monospace;
    font-size: 0.88rem; line-height: 1.6; resize: vertical;
    transition: border-color 0.2s, box-shadow 0.2s;
  }
  .code-answer-area:focus { outline: none; border-color: var(--green); box-shadow: 0 0 0 3px rgba(34, 197, 94, 0.12); }
  .code-label {
    display: flex; align-items: center; gap: 8px;
    font-size: 0.78rem; color: var(--text-muted); margin-bottom: 8px; font-weight: 600;
  }

  /* ── Submit area ── */
  .submit-area { text-align: center; padding: 40px 0 60px; }
</style>

<div style="min-height: 100vh; position: relative; z-index: 1;">

  <!-- ═══════ Top bar ═══════ -->
  <div class="test-topbar">
    <div class="test-info">
      <div class="brand" style="font-size: 1.05rem;">
        <div class="brand-dot"></div>
        ICUBE <span>Assessment</span>
      </div>
      <div style="border-left: 1px solid var(--border); padding-left: 14px;">
        <h2><%= test.title %></h2>
        <p><%= test.course %> &bull; <%= totalQuestions %> Questions &bull; <%= totalMarks %> Marks</p>
      </div>
    </div>
    <div class="test-progress">
      <span id="progressText">0 / <%= totalQuestions %></span>
      <div class="progress-bar">
        <div class="progress-fill" id="progressFill" style="width: 0%"></div>
      </div>
    </div>
    <div class="test-timer" id="timer">
      <span>⏱️</span>
      <span id="timerDisplay"><%= test.duration %>:00</span>
    </div>
  </div>

  <!-- ═══════ Sub-test tabs ═══════ -->
  <% if (sections.length > 1) { %>
  <div class="section-tabs">
    <% sections.forEach((sec, si) => { %>
      <div class="section-tab <%= si === 0 ? 'active' : '' %>"
           data-section="<%= si %>" onclick="switchSection(<%= si %>)">
        <% if (sec.type === 'code') { %>
          <span class="tab-type code">💻 Code</span>
        <% } else if (sec.type === 'mixed') { %>
          <span class="tab-type mixed">🔀 Mixed</span>
        <% } else { %>
          <span class="tab-type mcq">📋 MCQ</span>
        <% } %>
        <%= sec.name %>
        <span class="tab-badge"><%= sec.questions.length %> Q</span>
      </div>
    <% }) %>
  </div>
  <% } %>

  <!-- ═══════ Test Form ═══════ -->
  <form action="/student/test/<%= test._id %>/submit" method="POST" id="testForm">
    <input type="hidden" name="timeTaken" id="timeTaken" value="0">

    <% let globalIdx = 0; %>
    <% sections.forEach((sec, si) => { %>
      <div class="section-panel <%= si === 0 ? 'active' : '' %>" id="sectionPanel-<%= si %>">

        <% if (sec.description) { %>
          <p style="color: var(--text-muted); font-size: 0.86rem; margin-bottom: 22px; line-height: 1.5;"><%= sec.description %></p>
        <% } %>

        <% sec.questions.forEach((q, qi) => { globalIdx++; %>
          <div class="question-card">
            <div class="question-header">
              <span class="question-number"><%= globalIdx %></span>
              <span class="question-text"><%= q.questionText %></span>
              <span class="question-marks"><%= q.marks || 1 %> mark<%= (q.marks || 1) > 1 ? 's' : '' %></span>
            </div>

            <% if (sec.type === 'code' || q.type === 'code') { %>
              <!-- Coding question: textarea -->
              <div>
                <div class="code-label">
                  <span>💻</span> Write your answer / solution code below
                </div>
                <textarea class="code-answer-area"
                          name="q_<%= q._id %>"
                          placeholder="Type your code or answer here..."
                          oninput="updateProgress()"></textarea>
              </div>
            <% } else { %>
              <!-- MCQ question: radio buttons -->
              <div class="mcq-options">
                <div>
                  <input type="radio" name="q_<%= q._id %>" value="A" id="q_<%= q._id %>_A" class="mcq-option" onchange="updateProgress()">
                  <label for="q_<%= q._id %>_A" class="mcq-label">
                    <span class="mcq-marker">A</span>
                    <span><%= q.optionA %></span>
                  </label>
                </div>
                <div>
                  <input type="radio" name="q_<%= q._id %>" value="B" id="q_<%= q._id %>_B" class="mcq-option" onchange="updateProgress()">
                  <label for="q_<%= q._id %>_B" class="mcq-label">
                    <span class="mcq-marker">B</span>
                    <span><%= q.optionB %></span>
                  </label>
                </div>
                <div>
                  <input type="radio" name="q_<%= q._id %>" value="C" id="q_<%= q._id %>_C" class="mcq-option" onchange="updateProgress()">
                  <label for="q_<%= q._id %>_C" class="mcq-label">
                    <span class="mcq-marker">C</span>
                    <span><%= q.optionC %></span>
                  </label>
                </div>
                <div>
                  <input type="radio" name="q_<%= q._id %>" value="D" id="q_<%= q._id %>_D" class="mcq-option" onchange="updateProgress()">
                  <label for="q_<%= q._id %>_D" class="mcq-label">
                    <span class="mcq-marker">D</span>
                    <span><%= q.optionD %></span>
                  </label>
                </div>
              </div>
            <% } %>
          </div>
        <% }) %>

      </div>
    <% }) %>

    <div class="submit-area">
      <button type="submit" class="btn btn-primary btn-lg" id="submitBtn" onclick="return confirmSubmit()">
        📤 Submit Test for Manual Verification
      </button>
    </div>
  </form>
</div>

<script>
// ── Section tab switching ──
function switchSection(idx) {
  document.querySelectorAll('.section-panel').forEach(p => p.classList.remove('active'));
  document.querySelectorAll('.section-tab').forEach(t => t.classList.remove('active'));
  const targetPanel = document.getElementById('sectionPanel-' + idx);
  if (targetPanel) targetPanel.classList.add('active');
  const targetTab = document.querySelector('.section-tab[data-section="' + idx + '"]');
  if (targetTab) targetTab.classList.add('active');
}

// ── Timer ──
const totalSeconds = <%= test.duration %> * 60;
let remainingSeconds = totalSeconds;
let elapsedSeconds = 0;

function updateTimer() {
  const minutes = Math.floor(remainingSeconds / 60);
  const seconds = remainingSeconds % 60;
  const display = document.getElementById('timerDisplay');
  const timer = document.getElementById('timer');

  if (display) {
    display.textContent = `${minutes.toString().padStart(2, '0')}:${seconds.toString().padStart(2, '0')}`;
  }

  if (timer) {
    if (remainingSeconds <= 60) {
      timer.className = 'test-timer danger';
    } else if (remainingSeconds <= 300) {
      timer.className = 'test-timer warning';
    }
  }

  if (remainingSeconds <= 0) {
    clearInterval(timerInterval);
    document.getElementById('timeTaken').value = elapsedSeconds;
    alert('⏰ Time is up! Your test will be submitted automatically.');
    document.getElementById('testForm').submit();
    return;
  }

  remainingSeconds--;
  elapsedSeconds++;
  document.getElementById('timeTaken').value = elapsedSeconds;
}

const timerInterval = setInterval(updateTimer, 1000);

// ── Progress tracking ──
const totalQuestions = <%= totalQuestions %>;

function updateProgress() {
  const mcqAnswered = document.querySelectorAll('.mcq-option:checked').length;
  const codeAnswered = Array.from(document.querySelectorAll('.code-answer-area'))
    .filter(ta => ta.value.trim().length > 0).length;
  const answered = mcqAnswered + codeAnswered;

  const progressText = document.getElementById('progressText');
  const progressFill = document.getElementById('progressFill');
  if (progressText) progressText.textContent = `${answered} / ${totalQuestions}`;
  if (progressFill) progressFill.style.width = `${(answered / totalQuestions) * 100}%`;
}

function confirmSubmit() {
  const mcqAnswered = document.querySelectorAll('.mcq-option:checked').length;
  const codeAnswered = Array.from(document.querySelectorAll('.code-answer-area'))
    .filter(ta => ta.value.trim().length > 0).length;
  const answered = mcqAnswered + codeAnswered;
  const unanswered = totalQuestions - answered;

  if (unanswered > 0) {
    return confirm(`You have ${unanswered} unanswered question(s). Are you sure you want to submit for recruiter review?`);
  }
  return confirm('Are you sure you want to submit your assessment?');
}

// ── Anti‑cheat: disable right‑click, text selection and common copy shortcuts ──
document.addEventListener('contextmenu', e => e.preventDefault());

document.addEventListener('keydown', e => {
  if ((e.ctrlKey || e.metaKey) && ['c','v','x','a'].includes(e.key.toLowerCase())) {
    e.preventDefault();
  }
});

document.querySelectorAll('.question-card').forEach(card => {
  card.style.userSelect = 'none';
});

window.addEventListener('beforeunload', e => {
  e.preventDefault();
  e.returnValue = 'Are you sure you want to leave? Your progress will be lost.';
});

document.getElementById('testForm').addEventListener('submit', function() {
  window.onbeforeunload = null;
});
</script>

<%- include('../partials/footer') %>
