<%- include('../partials/header') %>

<div class="dashboard-layout">
  <%- include('../partials/admin-sidebar', { active: 'results' }) %>

  <div class="main-content">
    <div class="page-header">
      <div class="page-header-actions" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px;">
        <div>
          <h1>📈 All Candidate Submissions</h1>
          <p>Complete record of all candidates who have completed and submitted their tests</p>
        </div>
        <div style="display: flex; gap: 12px; align-items: center; flex-wrap: wrap;">
          <input type="text" id="resultSearchInput" placeholder="🔍 Search candidate, email, test..." 
                 style="padding: 8px 14px; background: rgba(255,255,255,0.06); border: 1px solid var(--border); border-radius: 8px; color: #fff; font-size: 0.9rem; min-width: 260px; outline: none;"
                 onkeyup="filterResults()">
          <span class="badge badge-success" style="font-size: 0.95rem; padding: 8px 16px;">
            <%= results.length %> Total Submissions
          </span>
        </div>
      </div>
    </div>

    <div class="page-body">
      <%- include('../partials/alerts') %>

      <div class="card">
        <div class="table-responsive">
          <table class="data-table">
            <thead>
              <tr>
                <th>Student</th>
                <th>Test</th>
                <th>Course</th>
                <th>Score</th>
                <th>Percentage</th>
                <th>Result</th>
                <th>Proctoring</th>
                <th>Date</th>
                <th>Action</th>
              </tr>
            </thead>
            <tbody>
              <% if (results.length === 0) { %>
                <tr>
                  <td colspan="9">
                    <div class="empty-state">
                      <span class="empty-icon">📈</span>
                      <h3>No submissions yet</h3>
                      <p>Results will appear here when students complete their tests.</p>
                    </div>
                  </td>
                </tr>
              <% } else { %>
                <% results.forEach(result => { %>
                  <tr>
                    <td>
                      <strong style="color: var(--text-primary)"><%= result.student ? result.student.name : 'Deleted' %></strong>
                      <br><small style="color: var(--text-muted)"><%= result.student ? result.student.email : '' %></small>
                    </td>
                    <td><%= result.test ? result.test.title : 'Deleted' %></td>
                    <td><span class="badge badge-info"><%= result.test ? result.test.course : 'N/A' %></span></td>
                    <td><strong><%= result.obtainedMarks %> / <%= result.totalMarks %></strong></td>
                    <td>
                      <span style="color: <%= result.percentage >= 70 ? 'var(--success)' : result.percentage >= 40 ? 'var(--warning)' : 'var(--danger)' %>; font-weight: 700;">
                        <%= result.percentage %>%
                      </span>
                    </td>
                    <td>
                      <span class="badge <%= result.isPassed ? 'badge-success' : 'badge-danger' %>">
                        <%= result.isPassed ? '✅ Passed' : '❌ Failed' %>
                      </span>
                    </td>
                    <td>
                      <% const tabCount = result.tabSwitchesCount || 0; %>
                      <% const fsCount = result.fullscreenExitsCount || 0; %>
                      <% if (tabCount > 0 || fsCount > 0) { %>
                        <span class="badge badge-danger" title="<%= tabCount %> tab switch(es), <%= fsCount %> fullscreen exit(s)">
                          🚨 <%= tabCount %> Tab Switch<%= tabCount !== 1 ? 'es' : '' %>
                        </span>
                      <% } else { %>
                        <span class="badge badge-success">🛡️ Clean</span>
                      <% } %>
                    </td>
                    <td><%= new Date(result.submittedAt).toLocaleDateString('en-IN') %></td>
                    <td style="display: flex; gap: 6px; align-items: center;">
                      <a href="/admin/results/<%= result._id %>" class="btn btn-sm btn-outline">👁️ View</a>
                      <form action="/admin/results/<%= result._id %>/reassign" method="POST" style="margin:0;"
                            onsubmit="return confirm('Delete this result and allow the student to retake the test?')">
                        <button type="submit" class="btn btn-sm btn-warning" title="Delete result & allow retake">🔄 Re-assign</button>
                      </form>
                    </td>
                  </tr>
                <% }) %>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  function filterResults() {
    const query = document.getElementById('resultSearchInput').value.toLowerCase();
    const rows = document.querySelectorAll('.data-table tbody tr');
    rows.forEach(row => {
      if (row.querySelector('.empty-state')) return;
      const text = row.innerText.toLowerCase();
      row.style.display = text.includes(query) ? '' : 'none';
    });
  }
</script>

<%- include('../partials/footer') %>
