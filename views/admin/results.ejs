<%- include('../partials/header') %>

<div class="dashboard-layout">
  <%- include('../partials/admin-sidebar', { active: 'results' }) %>

  <div class="main-content">
    <!-- Top Header -->
    <div class="page-header">
      <div class="page-header-actions" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 14px;">
        <div>
          <h1 style="display: flex; align-items: center; gap: 8px; margin: 0; font-size: 1.6rem;">
            📈 All Candidate Submissions &amp; Results
          </h1>
          <p style="margin: 4px 0 0 0; color: var(--text-muted); font-size: 0.9rem;">
            Review candidate scores, anti-cheat proctoring audits, and dispatch official Bitzbolt evaluation reports via email
          </p>
        </div>
        <div style="display: flex; gap: 10px; align-items: center; flex-wrap: wrap;">
          <input type="text" id="resultSearchInput" placeholder="🔍 Search candidate, email, test..." 
                 style="padding: 8px 14px; background: rgba(255,255,255,0.06); border: 1px solid var(--border); border-radius: 8px; color: #fff; font-size: 0.88rem; min-width: 240px; outline: none;"
                 onkeyup="filterResultsTable()">
          <select id="statusFilterSelect" onchange="filterResultsTable()" 
                  style="padding: 8px 12px; background: #1e293b; border: 1px solid var(--border); border-radius: 8px; color: #fff; font-size: 0.88rem; outline: none;">
            <option value="all">All Results</option>
            <option value="passed">✅ Passed Only</option>
            <option value="failed">❌ Failed Only</option>
            <option value="flagged">🚨 Flagged Proctoring</option>
          </select>
        </div>
      </div>
    </div>

    <div class="page-body">
      <%- include('../partials/alerts') %>

      <%
        const totalSubmissions = results.length;
        const passedCount = results.filter(r => r.isPassed).length;
        const failedCount = totalSubmissions - passedCount;
        const flaggedCount = results.filter(r => (r.tabSwitchesCount || 0) > 0 || (r.fullscreenExitsCount || 0) > 0 || (r.copyPasteAttempts || 0) > 0).length;
        const pendingCount = (typeof pendingPaidCandidates !== 'undefined' && pendingPaidCandidates) ? pendingPaidCandidates.length : 0;
      %>

      <!-- 4 High-Level Summary Metric Cards -->
      <div class="stats-grid" style="grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); gap: 14px; margin-bottom: 22px;">
        <div class="stat-card" style="background: rgba(255,255,255,0.02); border: 1px solid var(--border); padding: 16px; border-radius: 10px;">
          <div style="display: flex; justify-content: space-between; align-items: center;">
            <span style="font-size: 1.4rem;">📊</span>
            <span style="font-size: 1.6rem; font-weight: 800; color: #fff;"><%= totalSubmissions %></span>
          </div>
          <div style="font-size: 0.82rem; font-weight: 700; color: #fff; margin-top: 6px;">Total Submissions</div>
          <div style="font-size: 0.74rem; color: var(--text-muted); margin-top: 2px;">Completed assessments logged</div>
        </div>

        <div class="stat-card" style="background: rgba(34,197,94,0.04); border: 1px solid rgba(34,197,94,0.25); padding: 16px; border-radius: 10px;">
          <div style="display: flex; justify-content: space-between; align-items: center;">
            <span style="font-size: 1.4rem;">✅</span>
            <span style="font-size: 1.6rem; font-weight: 800; color: #22c55e;">
              <%= passedCount %> <small style="font-size: 0.8rem; font-weight: 500; color: #86efac;">(<%= totalSubmissions > 0 ? Math.round((passedCount/totalSubmissions)*100) : 0 %>%)</small>
            </span>
          </div>
          <div style="font-size: 0.82rem; font-weight: 700; color: #22c55e; margin-top: 6px;">Passed Requirement</div>
          <div style="font-size: 0.74rem; color: var(--text-muted); margin-top: 2px;">Met minimum passing marks</div>
        </div>

        <div class="stat-card" style="background: rgba(239,68,68,0.04); border: 1px solid rgba(239,68,68,0.25); padding: 16px; border-radius: 10px;">
          <div style="display: flex; justify-content: space-between; align-items: center;">
            <span style="font-size: 1.4rem;">🚨</span>
            <span style="font-size: 1.6rem; font-weight: 800; color: <%= flaggedCount > 0 ? '#f87171' : '#22c55e' %>;">
              <%= flaggedCount %>
            </span>
          </div>
          <div style="font-size: 0.82rem; font-weight: 700; color: <%= flaggedCount > 0 ? '#f87171' : '#22c55e' %>; margin-top: 6px;">Proctoring Flagged</div>
          <div style="font-size: 0.74rem; color: var(--text-muted); margin-top: 2px;">Window/tab switches recorded</div>
        </div>

        <div class="stat-card" style="background: rgba(245,158,11,0.04); border: 1px solid rgba(245,158,11,0.25); padding: 16px; border-radius: 10px;">
          <div style="display: flex; justify-content: space-between; align-items: center;">
            <span style="font-size: 1.4rem;">💳</span>
            <span style="font-size: 1.6rem; font-weight: 800; color: #fbbf24;"><%= pendingCount %></span>
          </div>
          <div style="font-size: 0.82rem; font-weight: 700; color: #fbbf24; margin-top: 6px;">Awaiting Test (Paid)</div>
          <div style="font-size: 0.74rem; color: var(--text-muted); margin-top: 2px;">Paid fee but test unsubmitted</div>
        </div>
      </div>

      <!-- Payment & Submission Status Tracking Banner -->
      <div style="background: rgba(34, 197, 94, 0.08); border: 1.5px solid rgba(34, 197, 94, 0.3); border-radius: 12px; padding: 16px 20px; margin-bottom: 22px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 14px;">
        <div>
          <div style="font-weight: 800; color: #fff; font-size: 1rem; margin-bottom: 4px; display: flex; align-items: center; gap: 8px;">
            <span>💳</span> Candidate Payment &amp; Submission Tracking
          </div>
          <div style="color: var(--text-muted); font-size: 0.86rem; line-height: 1.45;">
            <strong style="color: var(--green);"><%= totalSubmissions %> candidates</strong> have completed and submitted their tests.
            <% if (pendingCount > 0) { %>
              &bull; <strong style="color: #fbbf24;"><%= pendingCount %> candidates</strong> have paid assessment fees but have not submitted their test yet.
            <% } %>
          </div>
        </div>
        <div style="display: flex; gap: 10px; align-items: center;">
          <a href="/admin/payments" class="btn btn-sm btn-primary" style="font-size: 0.84rem; padding: 7px 14px;">
            💳 View All Paid Candidates (<%= (typeof payments !== 'undefined' ? payments.length : results.length) %>) →
          </a>
        </div>
      </div>

      <!-- Main Submissions Table Card -->
      <div class="card" style="border: 1px solid var(--border); border-radius: 10px; overflow: hidden;">
        <div class="card-header" style="display: flex; justify-content: space-between; align-items: center; padding: 14px 18px; border-bottom: 1px solid var(--border);">
          <h3 style="margin: 0; font-size: 1rem; color: #fff; display: flex; align-items: center; gap: 8px;">
            <span>📋</span> Submissions Log (<span id="visibleResultsCount"><%= results.length %></span> Visible)
          </h3>
          <span style="font-size: 0.78rem; color: var(--text-muted);">
            Tip: Click <strong>✉️ Email</strong> on any candidate to send their official Bitzbolt evaluation report.
          </span>
        </div>

        <div class="table-responsive" style="overflow-x: auto;">
          <table class="data-table" id="resultsMainTable" style="width: 100%; border-collapse: collapse;">
            <thead>
              <tr style="background: rgba(255,255,255,0.03); border-bottom: 1.5px solid var(--border); text-align: left; font-size: 0.8rem; text-transform: uppercase; color: var(--text-muted); letter-spacing: 0.5px;">
                <th style="padding: 12px 14px; min-width: 190px;">Candidate</th>
                <th style="padding: 12px 14px; min-width: 150px;">Assessment</th>
                <th style="padding: 12px 14px; min-width: 120px;">Score &amp; %</th>
                <th style="padding: 12px 14px; min-width: 100px;">MCQ Result</th>
                <th style="padding: 12px 14px; min-width: 140px;">Proctoring</th>
                <th style="padding: 12px 14px; min-width: 100px;">Submitted</th>
                <th style="padding: 12px 14px; min-width: 230px; text-align: center;">Actions</th>
              </tr>
            </thead>
            <tbody>
              <% if (results.length === 0) { %>
                <tr>
                  <td colspan="7">
                    <div class="empty-state" style="padding: 40px 20px; text-align: center;">
                      <span class="empty-icon" style="font-size: 2.5rem;">📈</span>
                      <h3 style="color: #fff; margin: 10px 0 4px 0;">No submissions yet</h3>
                      <p style="color: var(--text-muted); margin: 0;">Results will appear here when students complete their tests.</p>
                    </div>
                  </td>
                </tr>
              <% } else { %>
                <% results.forEach(result => { %>
                  <%
                    // Calculate Question Breakdown for this result
                    let reviewQuestions = [];
                    if (result.test) {
                      if (result.test.questions && result.test.questions.length > 0) {
                        reviewQuestions.push(...result.test.questions);
                      }
                      if (result.test.subTests && result.test.subTests.length > 0) {
                        result.test.subTests.forEach(st => {
                          if (st.questions && st.questions.length > 0) {
                            reviewQuestions.push(...st.questions);
                          }
                        });
                      }
                    }

                    let correctCount = 0;
                    let wrongCount = 0;
                    let unansweredCount = 0;
                    let codingCount = 0;
                    let codingAttempted = 0;

                    reviewQuestions.forEach(q => {
                      const isCode = (q.type === 'coding' || q.type === 'code');
                      const ans = result.answers ? result.answers.find(a => a.questionId.toString() === q._id.toString()) : null;
                      
                      if (isCode) {
                        codingCount++;
                        const code = ans && (ans.codeAnswer || ans.selectedOption);
                        if (code && code.trim()) {
                          codingAttempted++;
                          if (ans.isCorrect) correctCount++;
                        } else {
                          unansweredCount++;
                        }
                      } else {
                        if (!ans || !ans.selectedOption || ans.selectedOption.trim() === '') {
                          unansweredCount++;
                        } else if (ans.isCorrect) {
                          correctCount++;
                        } else {
                          wrongCount++;
                        }
                      }
                    });

                    if (reviewQuestions.length === 0 && result.answers && result.answers.length > 0) {
                      result.answers.forEach(ans => {
                        if (!ans.selectedOption && !ans.codeAnswer) {
                          unansweredCount++;
                        } else if (ans.isCorrect) {
                          correctCount++;
                        } else {
                          wrongCount++;
                        }
                      });
                    }

                    const totalQuestionsCount = reviewQuestions.length || (result.answers ? result.answers.length : 0);

                    let defaultInterviewQual = 'Rejected';
                    let defaultInterviewReason = 'student not attempt the programming question';

                    if (codingCount > 0 && codingAttempted === 0) {
                      defaultInterviewQual = 'Rejected';
                      defaultInterviewReason = 'student not attempt the programming question';
                    } else if (!result.isPassed) {
                      defaultInterviewQual = 'Rejected';
                      defaultInterviewReason = 'Did not meet minimum passing threshold';
                    } else {
                      defaultInterviewQual = 'Qualified';
                      defaultInterviewReason = 'Successfully cleared technical assessment criteria';
                    }

                    const tabCount = result.tabSwitchesCount || 0;
                    const fsCount = result.fullscreenExitsCount || 0;
                    const cpCount = result.copyPasteAttempts || 0;
                    const hasViolations = (tabCount > 0 || fsCount > 0 || cpCount > 0);

                    const emailPayload = {
                      reportId: result._id.toString(),
                      candidateName: result.student ? result.student.name : 'Candidate',
                      candidateEmail: result.student ? result.student.email : '',
                      candidatePhone: (result.student && result.student.phone) ? result.student.phone : 'N/A',
                      refId: (result.student && result.student.refId) ? result.student.refId : 'Bit250903XR3',
                      company: (result.student && result.student.company) ? result.student.company : 'Bitzbolt',
                      testTitle: result.test ? result.test.title : 'Assessment',
                      track: result.test ? result.test.course : 'Technical Evaluation',
                      submissionDate: new Date(result.submittedAt).toLocaleString('en-IN'),
                      duration: Math.floor((result.timeTaken || 0) / 60) + ' mins ' + ((result.timeTaken || 0) % 60) + ' secs',
                      obtainedMarks: result.obtainedMarks,
                      totalMarks: result.totalMarks,
                      percentage: result.percentage,
                      isPassed: result.isPassed,
                      correctCount,
                      wrongCount,
                      unansweredCount,
                      totalQuestions: totalQuestionsCount,
                      tabSwitches: tabCount,
                      fullscreenExits: fsCount,
                      copyPaste: cpCount,
                      defaultQual: defaultInterviewQual,
                      defaultReason: defaultInterviewReason
                    };
                  %>
                  <tr class="result-row" data-passed="<%= result.isPassed ? 'true' : 'false' %>" data-flagged="<%= hasViolations ? 'true' : 'false' %>" style="border-bottom: 1px solid var(--border); transition: background 0.15s ease;">
                    <!-- Candidate Info -->
                    <td style="padding: 12px 14px; vertical-align: middle;">
                      <div style="font-weight: 700; color: #fff; font-size: 0.92rem;"><%= result.student ? result.student.name : 'Deleted Candidate' %></div>
                      <div style="color: var(--text-muted); font-size: 0.78rem; margin-top: 2px;"><%= result.student ? result.student.email : 'No email' %></div>
                      <div style="margin-top: 3px;">
                        <span style="font-size: 0.7rem; color: #38bdf8; background: rgba(56,189,248,0.1); border: 1px solid rgba(56,189,248,0.25); padding: 1px 6px; border-radius: 4px; font-family: monospace;">
                          <%= (result.student && result.student.refId) ? result.student.refId : 'Bit250903XR3' %>
                        </span>
                      </div>
                    </td>

                    <!-- Assessment Title & Course -->
                    <td style="padding: 12px 14px; vertical-align: middle;">
                      <div style="font-weight: 600; color: #e2e8f0; font-size: 0.88rem;"><%= result.test ? result.test.title : 'Deleted Assessment' %></div>
                      <span class="badge badge-info" style="font-size: 0.72rem; margin-top: 4px; display: inline-block;">
                        <%= result.test ? result.test.course : 'General' %>
                      </span>
                    </td>

                    <!-- Score & Percentage -->
                    <td style="padding: 12px 14px; vertical-align: middle;">
                      <div style="font-weight: 800; color: #fff; font-size: 0.94rem;">
                        <%= result.obtainedMarks %> <span style="font-size: 0.76rem; color: var(--text-muted); font-weight: 400;">/ <%= result.totalMarks %></span>
                      </div>
                      <div style="font-weight: 700; font-size: 0.82rem; color: <%= result.percentage >= 70 ? 'var(--success)' : result.percentage >= 40 ? 'var(--warning)' : 'var(--danger)' %>; margin-top: 2px;">
                        <%= result.percentage %>%
                      </div>
                    </td>

                    <!-- MCQ Result Badge -->
                    <td style="padding: 12px 14px; vertical-align: middle;">
                      <span class="badge <%= result.isPassed ? 'badge-success' : 'badge-danger' %>" style="font-size: 0.76rem; padding: 4px 8px; white-space: nowrap;">
                        <%= result.isPassed ? '✅ Passed' : '❌ Failed' %>
                      </span>
                    </td>

                    <!-- Proctoring Anti-Cheat -->
                    <td style="padding: 12px 14px; vertical-align: middle;">
                      <% if (hasViolations) { %>
                        <span class="badge badge-danger" style="font-size: 0.76rem; padding: 4px 8px; display: inline-flex; align-items: center; gap: 4px; white-space: nowrap;" title="<%= tabCount %> tab switch(es), <%= fsCount %> fullscreen exit(s)">
                          🚨 <%= tabCount %> Tab Switch<%= tabCount !== 1 ? 'es' : '' %>
                        </span>
                        <% if (fsCount > 0) { %>
                          <span class="badge badge-warning" style="font-size: 0.7rem; padding: 2px 6px; margin-top: 3px; display: inline-block;">
                            🖥️ <%= fsCount %> Exit<%= fsCount !== 1 ? 's' : '' %>
                          </span>
                        <% } %>
                      <% } else { %>
                        <span class="badge badge-success" style="font-size: 0.76rem; padding: 4px 8px; white-space: nowrap;">
                          🛡️ Clean
                        </span>
                      <% } %>
                    </td>

                    <!-- Date -->
                    <td style="padding: 12px 14px; vertical-align: middle; font-size: 0.82rem; color: var(--text-muted); white-space: nowrap;">
                      <%= new Date(result.submittedAt).toLocaleDateString('en-IN') %>
                    </td>

                    <!-- Action Buttons -->
                    <td style="padding: 12px 14px; vertical-align: middle; text-align: center; white-space: nowrap;">
                      <div style="display: inline-flex; align-items: center; gap: 6px; justify-content: center;">
                        <!-- View Report Card -->
                        <a href="/admin/results/<%= result._id %>" class="btn btn-sm btn-outline" style="font-size: 0.78rem; padding: 5px 9px; display: inline-flex; align-items: center; gap: 4px;" title="View candidate report card & download PDF">
                          👁️ View
                        </a>

                        <!-- Email Button (Opens pre-filled Bitzbolt Assessment email modal) -->
                        <button type="button" class="btn btn-sm btn-primary" style="background: #2563eb; border-color: #2563eb; font-size: 0.78rem; padding: 5px 10px; display: inline-flex; align-items: center; gap: 4px; font-weight: 600;" 
                                onclick='openCandidateEmailModal(<%= JSON.stringify(emailPayload).replace(/'/g, "&#39;") %>)' title="Send BITZBOLT assessment report via Email">
                          ✉️ Email
                        </button>

                        <!-- Re-assign Test -->
                        <form action="/admin/results/<%= result._id %>/reassign" method="POST" style="margin: 0; display: inline-block;"
                              onsubmit="return confirm('Allow <%= result.student ? result.student.name : 'this student' %> to retake the test? This clears the submission.')">
                          <button type="submit" class="btn btn-sm btn-warning" style="font-size: 0.78rem; padding: 5px 8px; white-space: nowrap;" title="Delete result & allow retake">
                            🔄 Re-assign
                          </button>
                        </form>
                      </div>
                    </td>
                  </tr>
                <% }) %>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>

      <% if (typeof pendingPaidCandidates !== 'undefined' && pendingPaidCandidates && pendingPaidCandidates.length > 0) { %>
        <!-- Candidates Who Paid But Have Not Submitted -->
        <div class="card" style="margin-top: 28px; border: 1.5px solid rgba(245, 158, 11, 0.35); border-radius: 10px; overflow: hidden;">
          <div class="card-header" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px; padding: 14px 18px; background: rgba(245,158,11,0.06); border-bottom: 1px solid rgba(245, 158, 11, 0.2);">
            <div>
              <h3 style="color: #fbbf24; display: flex; align-items: center; gap: 8px; margin: 0; font-size: 1rem;">
                <span>⏳</span> Paid Candidates &bull; Test Not Submitted Yet (<%= pendingPaidCandidates.length %>)
              </h3>
              <p style="color: var(--text-muted); font-size: 0.82rem; margin: 2px 0 0 0;">
                These candidates have paid their assessment fees via Cashfree but have not completed/submitted their assessment yet
              </p>
            </div>
            <a href="/admin/payments" class="btn btn-sm btn-outline" style="font-size: 0.8rem;">Full Payments Tracking →</a>
          </div>
          <div class="table-responsive">
            <table class="data-table" style="width: 100%; border-collapse: collapse;">
              <thead>
                <tr style="border-bottom: 1.5px solid var(--border); font-size: 0.8rem; text-transform: uppercase; color: var(--text-muted);">
                  <th style="padding: 10px 14px;">Candidate</th>
                  <th style="padding: 10px 14px;">Assessment</th>
                  <th style="padding: 10px 14px;">Amount Paid</th>
                  <th style="padding: 10px 14px;">Cashfree ID</th>
                  <th style="padding: 10px 14px;">Payment Date</th>
                  <th style="padding: 10px 14px;">Status</th>
                  <th style="padding: 10px 14px; text-align: center;">Action</th>
                </tr>
              </thead>
              <tbody>
                <% pendingPaidCandidates.forEach(p => { %>
                  <tr style="border-bottom: 1px solid var(--border);">
                    <td style="padding: 10px 14px;">
                      <strong style="color: #fff;"><%= p.student ? p.student.name : 'Unknown Candidate' %></strong>
                      <br><small style="color: var(--text-muted);"><%= p.student ? p.student.email : 'No email' %></small>
                      <% if (p.student && p.student.phone) { %>
                        <br><small style="color: var(--green);">📞 <%= p.student.phone %></small>
                      <% } %>
                    </td>
                    <td style="padding: 10px 14px;">
                      <strong style="color: #fff;"><%= p.test ? p.test.title : 'Deleted Assessment' %></strong>
                      <br><span class="badge badge-info" style="font-size: 0.72rem;"><%= p.test ? p.test.course : 'General' %></span>
                    </td>
                    <td style="padding: 10px 14px;"><strong style="color: var(--green);">₹<%= p.amount %></strong></td>
                    <td style="padding: 10px 14px;">
                      <% if (p.paymentId) { %>
                        <code style="background: rgba(255,255,255,0.06); padding: 2px 6px; border-radius: 4px; font-size: 0.78rem; color: #38bdf8;"><%= p.paymentId %></code>
                      <% } else { %>
                        <span style="color: var(--text-muted); font-size: 0.8rem;">Direct / Free</span>
                      <% } %>
                    </td>
                    <td style="padding: 10px 14px; font-size: 0.82rem; color: var(--text-muted);"><%= new Date(p.createdAt).toLocaleDateString('en-IN') %></td>
                    <td style="padding: 10px 14px;">
                      <span class="badge badge-warning" style="font-weight: 700; font-size: 0.76rem;">
                        ⏳ Awaiting Submission
                      </span>
                    </td>
                    <td style="padding: 10px 14px; text-align: center;">
                      <form action="/admin/tests/<%= p.test ? p.test._id : '' %>/reset-attempt/<%= p.student ? p.student._id : '' %>" method="POST" style="margin: 0;" onsubmit="return confirm('Allow fresh free attempt for <%= p.student ? p.student.name : 'this candidate' %>? This clears any abandoned or glitched attempt.');">
                        <button type="submit" class="btn btn-sm btn-primary" style="white-space: nowrap; font-size: 0.78rem;" title="Reset attempt & allow candidate to take test fresh">
                          🔄 Allow Fresh Attempt
                        </button>
                      </form>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </div>
      <% } %>
    </div>
  </div>
</div>

<!-- ==================== SEND EMAIL MODAL (ON ALL RESULTS PAGE) ==================== -->
<div id="resultsEmailModal" class="custom-modal-backdrop" style="display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.8); backdrop-filter: blur(5px); z-index: 99999; align-items: center; justify-content: center; padding: 16px;">
  <div class="custom-modal-content" style="background: #0f172a; border: 1.5px solid #334155; border-radius: 12px; width: 100%; max-width: 650px; max-height: 92vh; overflow-y: auto; box-shadow: 0 25px 50px -12px rgba(0,0,0,0.6);">
    <div style="padding: 16px 22px; border-bottom: 1px solid #334155; display: flex; justify-content: space-between; align-items: center; position: sticky; top: 0; background: #0f172a; z-index: 2;">
      <h3 style="margin: 0; font-size: 1.1rem; color: #fff; display: flex; align-items: center; gap: 8px;">
        ✉️ Send BITZBOLT Assessment Report
      </h3>
      <button type="button" onclick="closeResultsEmailModal()" style="background: none; border: none; color: #94a3b8; font-size: 1.5rem; cursor: pointer; line-height: 1;">&times;</button>
    </div>
    
    <div style="padding: 20px 22px;">
      <!-- Candidate Quick Card -->
      <div style="background: rgba(255,255,255,0.03); border: 1px solid var(--border); border-radius: 8px; padding: 12px 16px; margin-bottom: 16px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px;">
        <div>
          <div style="font-weight: 700; color: #fff; font-size: 0.98rem;" id="modalCandidateName">-</div>
          <div style="color: var(--text-muted); font-size: 0.82rem;" id="modalCandidateMeta">-</div>
        </div>
        <div style="text-align: right;">
          <span class="badge" id="modalCandidateScoreBadge" style="font-size: 0.82rem; padding: 4px 10px;">-</span>
        </div>
      </div>

      <!-- Recipient Input -->
      <div style="margin-bottom: 12px;">
        <label style="display: block; font-size: 0.78rem; font-weight: 700; color: #cbd5e1; margin-bottom: 5px; text-transform: uppercase;">
          Recipient Email:
        </label>
        <input type="email" id="modalRecipientEmail" class="form-control" style="width: 100%; background: #1e293b; border: 1px solid #475569; color: #fff; padding: 9px 12px; border-radius: 6px; font-size: 0.88rem;">
      </div>

      <!-- Subject Input -->
      <div style="margin-bottom: 12px;">
        <label style="display: block; font-size: 0.78rem; font-weight: 700; color: #cbd5e1; margin-bottom: 5px; text-transform: uppercase;">
          Subject Line (Pre-filled):
        </label>
        <input type="text" id="modalEmailSubject" class="form-control" style="width: 100%; background: #1e293b; border: 1px solid #475569; color: #38bdf8; padding: 9px 12px; border-radius: 6px; font-size: 0.88rem; font-weight: 600;">
      </div>

      <!-- Qualification & Reason Customizer -->
      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 12px;">
        <div>
          <label style="display: block; font-size: 0.78rem; font-weight: 700; color: #cbd5e1; margin-bottom: 5px; text-transform: uppercase;">
            qualification for interview:
          </label>
          <select id="modalInterviewQual" onchange="updateResultsEmailBody()" class="form-control" style="width: 100%; background: #1e293b; border: 1px solid #475569; color: #fff; padding: 9px 12px; border-radius: 6px; font-size: 0.88rem; font-weight: 600;">
            <option value="Rejected">Rejected</option>
            <option value="Qualified">Qualified</option>
            <option value="On Hold / Under Evaluation">On Hold / Under Evaluation</option>
          </select>
        </div>
        <div>
          <label style="display: block; font-size: 0.78rem; font-weight: 700; color: #cbd5e1; margin-bottom: 5px; text-transform: uppercase;">
            Reason:
          </label>
          <input type="text" id="modalInterviewReason" oninput="updateResultsEmailBody()" class="form-control" style="width: 100%; background: #1e293b; border: 1px solid #475569; color: #fff; padding: 9px 12px; border-radius: 6px; font-size: 0.86rem;">
        </div>
      </div>

      <!-- Email Body Textarea Preview -->
      <div style="margin-bottom: 16px;">
        <label style="display: block; font-size: 0.78rem; font-weight: 700; color: #cbd5e1; margin-bottom: 5px; text-transform: uppercase;">
          Email Body Preview:
        </label>
        <textarea id="modalEmailBody" rows="8" readonly style="width: 100%; background: #1e293b; border: 1px solid #475569; color: #e2e8f0; padding: 10px 12px; border-radius: 6px; font-size: 0.8rem; font-family: 'JetBrains Mono', Consolas, monospace; line-height: 1.4; resize: vertical;"></textarea>
      </div>

      <!-- Action Buttons in Modal -->
      <div style="display: flex; gap: 10px; flex-wrap: wrap; margin-bottom: 12px;">
        <a id="btnModalOpenGmail" href="#" target="_blank" class="btn btn-primary" style="flex: 1; min-width: 170px; display: inline-flex; align-items: center; justify-content: center; gap: 8px; background: #dc2626; border-color: #dc2626; font-size: 0.88rem; padding: 10px; text-decoration: none; font-weight: 600;">
          <span>🌐</span> Open in Gmail Web
        </a>
        <a id="btnModalOpenMailto" href="#" class="btn btn-primary" style="flex: 1; min-width: 170px; display: inline-flex; align-items: center; justify-content: center; gap: 8px; background: #2563eb; border-color: #2563eb; font-size: 0.88rem; padding: 10px; text-decoration: none; font-weight: 600;">
          <span>✉️</span> Default Mail Client
        </a>
      </div>

      <div style="display: flex; gap: 10px; flex-wrap: wrap;">
        <button type="button" onclick="copyResultsEmailText()" class="btn btn-outline" style="flex: 1; min-width: 140px; font-size: 0.84rem; padding: 9px; display: inline-flex; align-items: center; justify-content: center; gap: 6px;">
          📋 Copy Email Text
        </button>
        <a id="btnModalViewReport" href="#" target="_blank" class="btn btn-outline" style="flex: 1; min-width: 170px; font-size: 0.84rem; padding: 9px; display: inline-flex; align-items: center; justify-content: center; gap: 6px; text-decoration: none;">
          📊 Full Report &amp; PDF →
        </a>
      </div>
    </div>
  </div>
</div>

<!-- ==================== CLIENT SCRIPTS FOR SEARCH & EMAIL MODAL ==================== -->
<script>
  let activeCandidateData = null;

  function filterResultsTable() {
    const query = document.getElementById('resultSearchInput').value.toLowerCase().trim();
    const filter = document.getElementById('statusFilterSelect').value;
    const rows = document.querySelectorAll('#resultsMainTable tbody tr.result-row');
    let visibleCount = 0;

    rows.forEach(row => {
      const text = row.innerText.toLowerCase();
      const isPassed = row.getAttribute('data-passed') === 'true';
      const isFlagged = row.getAttribute('data-flagged') === 'true';

      let matchFilter = true;
      if (filter === 'passed') matchFilter = isPassed;
      else if (filter === 'failed') matchFilter = !isPassed;
      else if (filter === 'flagged') matchFilter = isFlagged;

      const matchQuery = text.includes(query);

      if (matchFilter && matchQuery) {
        row.style.display = '';
        visibleCount++;
      } else {
        row.style.display = 'none';
      }
    });

    const countEl = document.getElementById('visibleResultsCount');
    if (countEl) countEl.innerText = visibleCount;
  }

  function openCandidateEmailModal(data) {
    activeCandidateData = data;

    // Set Header info
    document.getElementById('modalCandidateName').innerText = data.candidateName;
    document.getElementById('modalCandidateMeta').innerText = data.candidateEmail + ' • ' + data.testTitle + ' (' + data.track + ')';
    
    const badge = document.getElementById('modalCandidateScoreBadge');
    badge.innerText = data.obtainedMarks + ' / ' + data.totalMarks + ' (' + data.percentage + '%) ' + (data.isPassed ? 'PASSED' : 'FAILED');
    badge.className = 'badge ' + (data.isPassed ? 'badge-success' : 'badge-danger');

    // Set Inputs
    document.getElementById('modalRecipientEmail').value = data.candidateEmail || '';
    const subject = "BITZBOLT ASSESSMENT - " + data.candidateName + " - " + data.testTitle;
    document.getElementById('modalEmailSubject').value = subject;

    document.getElementById('modalInterviewQual').value = data.defaultQual || 'Rejected';
    document.getElementById('modalInterviewReason').value = data.defaultReason || 'student not attempt the programming question';

    // Set Full Report link
    document.getElementById('btnModalViewReport').href = '/admin/results/' + data.reportId;

    // Refresh email body and update links
    updateResultsEmailBody();

    // Show modal
    document.getElementById('resultsEmailModal').style.display = 'flex';
  }

  function closeResultsEmailModal() {
    document.getElementById('resultsEmailModal').style.display = 'none';
  }

  function buildResultsEmailBody() {
    if (!activeCandidateData) return '';
    const d = activeCandidateData;

    const qual = document.getElementById('modalInterviewQual').value;
    const reason = document.getElementById('modalInterviewReason').value;

    const totalViolations = (d.tabSwitches + d.fullscreenExits + d.copyPaste);
    const proctoringStatus = totalViolations === 0 
      ? "100% Clean (Zero violations recorded)" 
      : "Violations Logged (" + totalViolations + " incidents)";

    return [
      "======================================================",
      "ICUBE WORLD (ICUBE INFO SOLUTION)",
      "Conducted for: Bitzbolt (https://bitzbolt.online)",
      "======================================================",
      "CANDIDATE DETAILS:",
      "• Name: " + d.candidateName,
      "• Email: " + d.candidateEmail,
      "• Phone: " + d.candidatePhone,
      "• Reference ID: " + d.refId,
      "• Company: " + d.company,
      "",
      "ASSESSMENT PERFORMANCE:",
      "• Assessment: " + d.testTitle + " (" + d.track + ")",
      "• Submitted At: " + d.submissionDate,
      "• Duration: " + d.duration,
      "• Marks Obtained: " + d.obtainedMarks + " / " + d.totalMarks + " (" + d.percentage + "%)",
      "• MCQ Result: " + (d.isPassed ? "PASSED" : "NOT PASSED"),
      "",
      "QUESTION BREAKDOWN:",
      "• Total Questions: " + d.totalQuestions,
      "• Correct Answers: " + d.correctCount,
      "• Wrong Answers: " + d.wrongCount,
      "• Unanswered / Skipped: " + d.unansweredCount,
      "",
      "PROCTORING & ANTI-CHEAT AUDIT REPORT:",
      "• Switching Window / Tab Blur: " + d.tabSwitches + " count",
      "• Fullscreen Exits / Minimizes: " + d.fullscreenExits + " count",
      "• Copy / Paste Attempts: " + d.copyPaste + " count",
      "• Proctoring Integrity: " + proctoringStatus,
      "",
      "qualification for interview: " + qual,
      "Reason: " + reason,
      "------------------------------------------------------",
      "* NOTE: Please find attached the official Assessment Report Card PDF for the detailed question-by-question review and timestamped proctoring timeline.",
      "Verification Token: " + d.reportId
    ].join("\n");
  }

  function updateResultsEmailBody() {
    const bodyText = buildResultsEmailBody();
    document.getElementById('modalEmailBody').value = bodyText;

    const recipient = encodeURIComponent(document.getElementById('modalRecipientEmail').value.trim());
    const subject = encodeURIComponent(document.getElementById('modalEmailSubject').value.trim());
    const bodyEncoded = encodeURIComponent(bodyText);

    // Update real links on buttons so they are 100% clickable and never blocked by popup blocker!
    const gmailUrl = "https://mail.google.com/mail/?view=cm&fs=1&to=" + recipient + "&su=" + subject + "&body=" + bodyEncoded;
    document.getElementById('btnModalOpenGmail').href = gmailUrl;

    const mailtoUrl = "mailto:" + recipient + "?subject=" + subject + "&body=" + bodyEncoded;
    document.getElementById('btnModalOpenMailto').href = mailtoUrl;
  }

  // Also bind updates on recipient or subject change
  document.addEventListener('DOMContentLoaded', function() {
    const recInput = document.getElementById('modalRecipientEmail');
    const subInput = document.getElementById('modalEmailSubject');
    if (recInput) recInput.addEventListener('input', updateResultsEmailBody);
    if (subInput) subInput.addEventListener('input', updateResultsEmailBody);
  });

  function copyResultsEmailText() {
    const bodyField = document.getElementById('modalEmailBody');
    bodyField.select();
    bodyField.setSelectionRange(0, 99999);
    navigator.clipboard.writeText(bodyField.value).then(() => {
      alert("✅ Assessment report text copied to clipboard!");
    }).catch(err => {
      alert("Please copy manually from the box.");
    });
  }

  // Close modal when clicking outside
  window.addEventListener('click', function(e) {
    const modal = document.getElementById('resultsEmailModal');
    if (e.target === modal) {
      closeResultsEmailModal();
    }
  });
</script>

