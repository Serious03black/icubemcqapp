<%- include('../partials/header') %>

<div class="dashboard-layout">
  <%- include('../partials/admin-sidebar', { active: 'results' }) %>

  <div class="main-content">
    <div class="page-header">
      <div class="page-header-actions">
        <div>
          <h1>📊 Result Details</h1>
          <p><%= result.student ? result.student.name : 'Student' %> — <%= result.test ? result.test.title : 'Test' %></p>
        </div>
        <a href="/admin/results" class="btn btn-outline">← Back to Results</a>
      </div>
    </div>

    <div class="page-body">
      <!-- Result Summary -->
      <div class="card" style="margin-bottom: 24px;">
        <div class="card-body">
          <div class="result-summary">
            <div class="result-circle <%= result.isPassed ? 'passed' : 'failed' %>" style="--percentage: <%= result.percentage %>">
              <div class="result-percentage"><%= result.percentage %>%</div>
              <small style="color: var(--text-muted); font-size: 0.8rem;"><%= result.isPassed ? 'PASSED' : 'FAILED' %></small>
            </div>

            <div class="result-status" style="color: <%= result.isPassed ? 'var(--success)' : 'var(--danger)' %>">
              <%= result.isPassed ? '🎉 Congratulations! Passed' : '❌ Not Passed' %>
            </div>

            <div class="result-stats">
              <div class="result-stat">
                <div class="value"><%= result.obtainedMarks %></div>
                <div class="label">Obtained</div>
              </div>
              <div class="result-stat">
                <div class="value"><%= result.totalMarks %></div>
                <div class="label">Total Marks</div>
              </div>
              <div class="result-stat">
                <div class="value"><%= result.test ? result.test.passingMarks : 'N/A' %></div>
                <div class="label">Passing Marks</div>
              </div>
              <div class="result-stat">
                <div class="value">
                  <% if (result.timeTaken) { %>
                    <%= Math.floor(result.timeTaken / 60) %>m <%= result.timeTaken % 60 %>s
                  <% } else { %>
                    N/A
                  <% } %>
                </div>
                <div class="label">Time Taken</div>
              </div>
            </div>
          </div>
        </div>
      <!-- Proctoring & Anti-Cheat Audit Report -->
      <div class="card" style="margin-bottom: 24px; border: 1.5px solid <%= ((result.tabSwitchesCount || 0) > 0 || (result.fullscreenExitsCount || 0) > 0 || (result.copyPasteAttempts || 0) > 0) ? 'rgba(239, 68, 68, 0.45)' : 'rgba(34, 197, 94, 0.4)' %>;">
        <div class="card-header" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px;">
          <h3 style="display: flex; align-items: center; gap: 8px; margin: 0;">
            🛡️ Proctoring &amp; Anti-Cheat Audit Report
          </h3>
          <% if ((result.tabSwitchesCount || 0) === 0 && (result.fullscreenExitsCount || 0) === 0 && (result.copyPasteAttempts || 0) === 0) { %>
            <span class="badge badge-success" style="font-size: 0.85rem; padding: 6px 12px;">✅ 100% Clean Session</span>
          <% } else { %>
            <span class="badge badge-danger" style="font-size: 0.85rem; padding: 6px 12px;">🚨 Violations Logged (<%= (result.tabSwitchesCount || 0) + (result.fullscreenExitsCount || 0) %> Incidents)</span>
          <% } %>
        </div>
        <div class="card-body">
          <div class="stats-grid" style="grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); margin-bottom: 18px;">
            <div class="stat-card" style="background: rgba(255,255,255,0.02);">
              <div class="stat-icon <%= (result.tabSwitchesCount || 0) > 0 ? 'orange' : 'green' %>">📑</div>
              <div class="stat-value" style="color: <%= (result.tabSwitchesCount || 0) > 0 ? '#f87171' : '#22c55e' %>;">
                <%= result.tabSwitchesCount || 0 %>
              </div>
              <div class="stat-label">Tab Switches / Blur</div>
            </div>
            <div class="stat-card" style="background: rgba(255,255,255,0.02);">
              <div class="stat-icon <%= (result.fullscreenExitsCount || 0) > 0 ? 'orange' : 'green' %>">🖥️</div>
              <div class="stat-value" style="color: <%= (result.fullscreenExitsCount || 0) > 0 ? '#fbbf24' : '#22c55e' %>;">
                <%= result.fullscreenExitsCount || 0 %>
              </div>
              <div class="stat-label">Fullscreen Exits / Minimizes</div>
            </div>
            <div class="stat-card" style="background: rgba(255,255,255,0.02);">
              <div class="stat-icon <%= (result.copyPasteAttempts || 0) > 0 ? 'orange' : 'green' %>">📋</div>
              <div class="stat-value" style="color: <%= (result.copyPasteAttempts || 0) > 0 ? '#f87171' : '#22c55e' %>;">
                <%= result.copyPasteAttempts || 0 %>
              </div>
              <div class="stat-label">Copy / Paste / Cut Actions</div>
            </div>
          </div>

          <% if (result.proctoringLogs && result.proctoringLogs.length > 0) { %>
            <div style="margin-top: 14px;">
              <div style="font-size: 0.86rem; font-weight: 700; color: #fff; margin-bottom: 8px;">Detailed Audit Event Timeline (<%= result.proctoringLogs.length %> Events):</div>
              <div style="max-height: 240px; overflow-y: auto; background: rgba(0,0,0,0.3); border: 1px solid var(--border); border-radius: 8px; padding: 10px;">
                <table style="width: 100%; font-size: 0.8rem; border-collapse: collapse;">
                  <thead>
                    <tr style="border-bottom: 1px solid rgba(255,255,255,0.08); text-align: left; color: var(--text-muted);">
                      <th style="padding: 6px 10px; width: 140px;">Timestamp</th>
                      <th style="padding: 6px 10px; width: 150px;">Violation Type</th>
                      <th style="padding: 6px 10px;">Description</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% result.proctoringLogs.forEach(log => { %>
                      <tr style="border-bottom: 1px solid rgba(255,255,255,0.04);">
                        <td style="padding: 6px 10px; color: var(--text-muted); font-family: monospace;">
                          <%= new Date(log.timestamp).toLocaleTimeString('en-IN') %>
                        </td>
                        <td style="padding: 6px 10px;">
                          <span class="badge <%= log.action === 'tab_switch' ? 'badge-danger' : log.action === 'fullscreen_exit' ? 'badge-warning' : 'badge-info' %>" style="font-size: 0.7rem;">
                            <%= log.action %>
                          </span>
                        </td>
                        <td style="padding: 6px 10px; color: #e2e8f0;">
                          <%= log.message %>
                        </td>
                      </tr>
                    <% }) %>
                  </tbody>
                </table>
              </div>
            </div>
          <% } else { %>
            <div style="font-size: 0.84rem; color: #22c55e;">
              ✅ Candidate completed the examination in fullscreen with zero tab switches or violations.
            </div>
          <% } %>
        </div>
      </div>

      <!-- Answer Details -->
      <%
        let reviewQuestions = [];
        if (result.test) {
          if (result.test.questions && result.test.questions.length > 0) {
            reviewQuestions.push(...result.test.questions);
          }
          if (result.test.subTests && result.test.subTests.length > 0) {
            result.test.subTests.forEach(st => {
              if (st.questions && st.questions.length > 0) {
                reviewQuestions.push(...st.questions);
              }
            });
          }
        }
      %>
      <% if (reviewQuestions.length > 0) { %>
        <div class="card">
          <div class="card-header">
            <h3>📋 Answer Details</h3>
          </div>
          <div class="card-body">
            <% reviewQuestions.forEach((q, index) => { %>
              <% const answer = result.answers.find(a => a.questionId.toString() === q._id.toString()); %>
              <div class="question-card">
                <div style="margin-bottom: 12px; display: flex; align-items: flex-start; justify-content: space-between;">
                  <div>
                    <span class="question-number"><%= index + 1 %></span>
                    <span class="question-text"><%= q.questionText || 'Refer to the question image below:' %></span>
                    <span class="badge <%= (q.type === 'coding' || q.type === 'code') ? 'badge-warning' : 'badge-primary' %>" style="margin-left: 8px; font-size: 0.72rem;">
                      <%= (q.type === 'coding' || q.type === 'code') ? '💻 Coding' : '📋 MCQ' %>
                    </span>
                  </div>
                  <% if (answer && (q.type !== 'coding' && q.type !== 'code')) { %>
                    <span class="badge <%= answer.isCorrect ? 'badge-success' : 'badge-danger' %>">
                      <%= answer.isCorrect ? '✅ Correct' : '❌ Wrong' %>
                    </span>
                  <% } %>
                </div>

                <% if (q.imageUrl) { %>
                  <div style="margin: 10px 0 14px 0; background: rgba(0,0,0,0.3); border: 1px solid var(--border); border-radius: 8px; padding: 10px; text-align: center;">
                    <a href="<%= q.imageUrl %>" target="_blank" title="Click to view full image in a new tab">
                      <img src="<%= q.imageUrl %>" alt="Question Image" style="max-height: 260px; max-width: 100%; object-fit: contain; border-radius: 6px;">
                    </a>
                  </div>
                <% } %>

                <% if (q.type === 'coding' || q.type === 'code') { %>
                  <div style="margin-top: 10px; background: rgba(0,0,0,0.35); border: 1px solid var(--border); border-radius: 8px; padding: 14px;">
                    <div style="font-size: 0.78rem; font-weight: 700; color: #38bdf8; text-transform: uppercase; margin-bottom: 8px; display: flex; align-items: center; justify-content: space-between;">
                      <span>💻 Candidate Submitted Code:</span>
                      <span class="badge badge-warning" style="font-size: 0.7rem;">Needs Manual Verification</span>
                    </div>
                    <% const codeText = (answer && (answer.codeAnswer || answer.selectedOption)) ? (answer.codeAnswer || answer.selectedOption) : ''; %>
                    <% if (codeText.trim()) { %>
                      <pre style="margin: 0; padding: 12px; background: rgba(0,0,0,0.5); border-radius: 6px; color: #e2e8f0; font-family: 'JetBrains Mono', Consolas, monospace; font-size: 0.88rem; overflow-x: auto; white-space: pre-wrap; word-break: break-all;"><code><%= codeText %></code></pre>
                    <% } else { %>
                      <p style="color: var(--text-muted); font-style: italic; margin: 0; font-size: 0.85rem;">No code submitted by candidate.</p>
                    <% } %>
                  </div>
                <% } else { %>
                  <div class="options-grid">
                    <% ['A', 'B', 'C', 'D'].forEach(opt => { %>
                      <%
                        let optClass = '';
                        if (q.correctOption === opt) optClass = 'correct';
                        if (answer && answer.selectedOption === opt && !answer.isCorrect) optClass = 'wrong';
                        if (answer && answer.selectedOption === opt && answer.isCorrect) optClass = 'correct';
                      %>
                      <div class="option-item <%= optClass %>">
                        <span class="option-label"><%= opt %></span>
                        <span><%= q['option' + opt] %></span>
                        <% if (q.correctOption === opt) { %><small style="margin-left: auto; opacity: 0.7;">✓</small><% } %>
                        <% if (answer && answer.selectedOption === opt && answer.selectedOption !== q.correctOption) { %><small style="margin-left: auto; opacity: 0.7;">✗</small><% } %>
                      </div>
                    <% }) %>
                  </div>
                <% } %>
              </div>
            <% }) %>
          </div>
        </div>
      <% } %>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
