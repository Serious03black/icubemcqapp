<!-- ==================== CLIENT SCRIPTS FOR EMAIL & PDF ==================== -->
<script>
  const reportData = {
    candidateName: "<%= (result.student ? result.student.name : 'Candidate').replace(/"/g, '\"') %>",
    candidateEmail: "<%= (result.student ? result.student.email : '').replace(/"/g, '\"') %>",
    candidatePhone: "<%= ((result.student && result.student.phone) ? result.student.phone : 'N/A').replace(/"/g, '\"') %>",
    refId: "<%= ((result.student && result.student.refId) ? result.student.refId : 'Bit250903XR3').replace(/"/g, '\"') %>",
    company: "<%= ((result.student && result.student.company) ? result.student.company : 'Bitzbolt').replace(/"/g, '\"') %>",
    testTitle: "<%= (result.test ? result.test.title : 'Assessment').replace(/"/g, '\"') %>",
    track: "<%= (result.test ? result.test.course : 'Technical Evaluation').replace(/"/g, '\"') %>",
    submissionDate: "<%= new Date(result.submittedAt).toLocaleString('en-IN').replace(/"/g, '\"') %>",
    duration: "<%= Math.floor((result.timeTaken || 0) / 60) %> mins <%= (result.timeTaken || 0) % 60 %> secs",
    obtainedMarks: <%= result.obtainedMarks %>,
    totalMarks: <%= result.totalMarks %>,
    percentage: <%= result.percentage %>,
    isPassed: <%= result.isPassed %>,
    correctCount: <%= correctCount %>,
    wrongCount: <%= wrongCount %>,
    unansweredCount: <%= unansweredCount %>,
    totalQuestions: <%= totalQuestionsCount %>,
    tabSwitches: <%= result.tabSwitchesCount || 0 %>,
    fullscreenExits: <%= result.fullscreenExitsCount || 0 %>,
    copyPaste: <%= result.copyPasteAttempts || 0 %>,
    reportId: "<%= result._id %>"
  };

  const emailSubject = "BITZBOLT ASSESSMENT - " + reportData.candidateName + " - " + reportData.testTitle;

  const emailBodyText = [
    "======================================================",
    "ICUBE WORLD (ICUBE INFO SOLUTION)",
    "OFFICIAL ASSESSMENT REPORT CARD",
    "Conducted for: Bitzbolt (https://bitzbolt.online)",
    "======================================================",
    "",
    "CANDIDATE DETAILS:",
    "• Name: " + reportData.candidateName,
    "• Email: " + reportData.candidateEmail,
    "• Phone: " + reportData.candidatePhone,
    "• Reference ID: " + reportData.refId,
    "• Company: " + reportData.company,
    "",
    "ASSESSMENT PERFORMANCE:",
    "• Assessment: " + reportData.testTitle + " (" + reportData.track + ")",
    "• Submitted At: " + reportData.submissionDate,
    "• Duration: " + reportData.duration,
    "• Marks Obtained: " + reportData.obtainedMarks + " / " + reportData.totalMarks + " (" + reportData.percentage + "%)",
    "• Result Status: " + (reportData.isPassed ? "PASSED" : "NOT PASSED"),
    "",
    "QUESTION BREAKDOWN:",
    "• Total Questions: " + reportData.totalQuestions,
    "• Correct Answers: " + reportData.correctCount,
    "• Wrong Answers: " + reportData.wrongCount,
    "• Unanswered / Skipped: " + reportData.unansweredCount,
    "",
    "PROCTORING & ANTI-CHEAT AUDIT REPORT:",
    "• Switching Window / Tab Blur: " + reportData.tabSwitches + " count",
    "• Fullscreen Exits / Minimizes: " + reportData.fullscreenExits + " count",
    "• Copy / Paste Attempts: " + reportData.copyPaste + " count",
    "• Proctoring Integrity: " + ((reportData.tabSwitches === 0 && reportData.fullscreenExits === 0 && reportData.copyPaste === 0) ? "100% Clean (Zero violations recorded)" : "Violations Logged (" + (reportData.tabSwitches + reportData.fullscreenExits + reportData.copyPaste) + " incidents)"),
    "",
    "------------------------------------------------------",
    "* NOTE: Please find attached the official Assessment Report Card PDF for the detailed question-by-question review and timestamped proctoring timeline.",
    "",
    "Verification Portal: https://bitzbolt.online",
    "Evaluation Authority: ICUBE World (ICUBE Info Solution)",
    "Verification Token: " + reportData.reportId,
    "======================================================"
  ].join("\n");

  function openSendMailModal() {
    document.getElementById('modalEmailSubject').value = emailSubject;
    document.getElementById('modalEmailBody').value = emailBodyText;
    document.getElementById('sendMailModal').style.display = 'flex';
  }

  function closeSendMailModal() {
    document.getElementById('sendMailModal').style.display = 'none';
  }

  function launchEmailClient(type) {
    const to = encodeURIComponent(document.getElementById('modalRecipientEmail').value.trim() || reportData.candidateEmail);
    const sub = encodeURIComponent(emailSubject);
    const body = encodeURIComponent(emailBodyText);

    if (type === 'gmail') {
      const gmailUrl = "https://mail.google.com/mail/?view=cm&fs=1&to=" + to + "&su=" + sub + "&body=" + body;
      window.open(gmailUrl, '_blank');
    } else {
      const mailtoUrl = "mailto:" + to + "?subject=" + sub + "&body=" + body;
      window.location.href = mailtoUrl;
    }
  }

  function copyEmailSummary() {
    const bodyField = document.getElementById('modalEmailBody');
    bodyField.select();
    bodyField.setSelectionRange(0, 99999);
    navigator.clipboard.writeText(bodyField.value).then(() => {
      alert("✅ Email assessment report copied to clipboard!");
    }).catch(err => {
      alert("Please copy manually from the box.");
    });
  }

  function triggerPdfAndPrint() {
    window.print();
  }

  // Close modal when clicking outside
  window.addEventListener('click', function(e) {
    const modal = document.getElementById('sendMailModal');
    if (e.target === modal) {
      closeSendMailModal();
    }
  });
</script>

<%- include('../partials/footer') %>
