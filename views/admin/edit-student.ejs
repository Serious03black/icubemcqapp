<%- include('../partials/header') %>

<div class="dashboard-layout">
  <%- include('../partials/admin-sidebar', { active: 'students' }) %>

  <div class="main-content">
    <div class="page-header">
      <div class="page-header-actions">
        <div>
          <h1>✏️ Edit Candidate</h1>
          <p>Update candidate details for <%= student.name %></p>
        </div>
        <a href="/admin/students" class="btn btn-outline">← Back to Candidates</a>
      </div>
    </div>

    <div class="page-body">
      <%- include('../partials/alerts') %>

      <div class="card" style="max-width: 680px;">
        <div class="card-header">
          <h3>👤 Candidate Details</h3>
          <span class="badge <%= student.isActive ? 'badge-success' : 'badge-danger' %>">
            <%= student.isActive ? 'Active' : 'Inactive' %>
          </span>
        </div>
        <div class="card-body">
          <form action="/admin/students/<%= student._id %>/edit" method="POST">
            <div class="form-row">
              <div class="form-group">
                <label class="form-label" for="name">Full Name *</label>
                <input type="text" class="form-input" id="name" name="name" value="<%= student.name %>" required>
              </div>
              <div class="form-group">
                <label class="form-label" for="email">Email Address *</label>
                <input type="email" class="form-input" id="email" name="email" value="<%= student.email %>" required>
              </div>
            </div>

            <div class="form-row">
              <div class="form-group">
                <label class="form-label" for="password">New Password</label>
                <input type="password" class="form-input" id="password" name="password" placeholder="Leave blank to keep current">
              </div>
              <div class="form-group">
                <label class="form-label" for="phone">Phone Number</label>
                <input type="text" class="form-input" id="phone" name="phone" value="<%= student.phone || '' %>">
              </div>
            </div>

            <div class="form-group">
              <label class="form-label" for="course">Primary Domain / Track</label>
              <select class="form-select" id="course" name="course">
                <option value="">Select candidate track</option>
                <% [
                  'Artificial Intelligence', 'Data Science', 'Robotics', 'Machine Learning',
                  'MERN Stack', 'Python Full Stack', 'Java Full Stack', 'Cloud Computing',
                  'DevOps', 'Cybersecurity', 'UI/UX Design', 'Digital Marketing'
                ].forEach(c => { %>
                  <option value="<%= c %>" <%= student.course === c ? 'selected' : '' %>><%= c %></option>
                <% }) %>
              </select>
            </div>

            <div class="form-check" style="margin-top: 14px; margin-bottom: 20px;">
              <input type="checkbox" id="isActive" name="isActive" <%= student.isActive ? 'checked' : '' %>>
              <label for="isActive">Candidate account is active</label>
            </div>

            <div style="display: flex; gap: 12px;">
              <button type="submit" class="btn btn-primary btn-lg">Update Candidate</button>
              <a href="/admin/students" class="btn btn-outline btn-lg">Cancel</a>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
