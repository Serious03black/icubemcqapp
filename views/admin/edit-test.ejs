<%- include('../partials/header') %>

<div class="dashboard-layout">
  <%- include('../partials/admin-sidebar', { active: 'tests' }) %>

  <div class="main-content">
    <div class="page-header">
      <h1>✏️ Edit Test</h1>
      <p>Update test settings for "<%= test.title %>"</p>
    </div>

    <div class="page-body">
      <%- include('../partials/alerts') %>

      <div class="card" style="max-width: 640px;">
        <div class="card-body">
          <form action="/admin/tests/<%= test._id %>/edit" method="POST">
            <div class="form-group">
              <label class="form-label" for="title">Test Title *</label>
              <input type="text" class="form-input" id="title" name="title" value="<%= test.title %>" required>
            </div>

            <div class="form-group">
              <label class="form-label" for="description">Description</label>
              <textarea class="form-input" id="description" name="description" rows="3"><%= test.description || '' %></textarea>
            </div>

            <div class="form-group">
              <label class="form-label" for="course">Course / Category *</label>
              <select class="form-select" id="course" name="course" required>
                <option value="">Select a course</option>
                <% ['MERN Stack', 'Data Science', 'Python Full Stack', 'Java Full Stack', 'DevOps', 'Cloud Computing', 'Machine Learning', 'Digital Marketing', 'UI/UX Design'].forEach(c => { %>
                  <option value="<%= c %>" <%= test.course === c ? 'selected' : '' %>><%= c %></option>
                <% }) %>
              </select>
            </div>

            <div class="form-row">
              <div class="form-group">
                <label class="form-label" for="duration">Duration (minutes) *</label>
                <input type="number" class="form-input" id="duration" name="duration" value="<%= test.duration %>" min="5" max="180" required>
              </div>
              <div class="form-group">
                <label class="form-label" for="passingMarks">Passing Marks</label>
                <input type="number" class="form-input" id="passingMarks" name="passingMarks" value="<%= test.passingMarks %>" min="0">
              </div>
            </div>

            <div class="form-check">
              <input type="checkbox" id="isActive" name="isActive" <%= test.isActive ? 'checked' : '' %>>
              <label for="isActive">Test is Active</label>
            </div>

            <div style="display: flex; gap: 12px; margin-top: 8px;">
              <button type="submit" class="btn btn-primary btn-lg">Update Test</button>
              <a href="/admin/tests" class="btn btn-outline btn-lg">Cancel</a>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
