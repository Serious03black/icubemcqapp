<%- include('../partials/header') %>

<style>
  .subtests-section { margin-top: 28px; }
  .subtests-header  { display: flex; align-items: center; justify-content: space-between; margin-bottom: 12px; }
  .subtests-header h3 { font-size: 1rem; font-weight: 600; color: var(--text-primary, #e2e8f0); margin: 0; }
  .subtest-card {
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 10px;
    padding: 16px 18px;
    margin-bottom: 12px;
    position: relative;
    animation: fadeIn 0.25s ease;
  }
  @keyframes fadeIn { from { opacity:0; transform:translateY(6px); } to { opacity:1; transform:none; } }
  .subtest-card .card-title { font-size: 0.85rem; font-weight: 700; color: var(--green); margin-bottom: 12px; letter-spacing: 0.05em; text-transform: uppercase; }
  .subtest-card .remove-btn { position: absolute; top: 12px; right: 14px; background: rgba(239,68,68,0.15); border: none; color: #f87171; border-radius: 6px; padding: 4px 10px; cursor: pointer; font-size: 0.78rem; font-weight: 600; transition: background 0.2s; }
  .subtest-card .remove-btn:hover { background: rgba(239,68,68,0.35); }
  .subtest-row { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  #addSubTestBtn { background: var(--green-dim); border: 1.5px dashed rgba(34, 197, 94, 0.45); color: var(--green); border-radius: 8px; padding: 10px 20px; cursor: pointer; font-size: 0.9rem; font-weight: 600; width: 100%; transition: background 0.2s, border-color 0.2s; margin-top: 4px; }
  #addSubTestBtn:hover { background: rgba(34, 197, 94, 0.25); border-color: var(--green); }
  .no-subtests-hint { text-align: center; color: rgba(255,255,255,0.35); font-size: 0.85rem; padding: 18px 0 8px; }
</style>

<div class="dashboard-layout">
  <%- include('../partials/admin-sidebar', { active: 'tests' }) %>

  <div class="main-content">
    <div class="page-header">
      <h1>✏️ Edit Test</h1>
      <p>Update test settings for "<%= test.title %>"</p>
    </div>

    <div class="page-body">
      <%- include('../partials/alerts') %>

      <div class="card" style="max-width: 720px;">
        <div class="card-body">
          <form action="/admin/tests/<%= test._id %>/edit" method="POST">

            <div class="form-group">
              <label class="form-label" for="title">Test Title *</label>
              <input type="text" class="form-input" id="title" name="title" value="<%= test.title %>" required>
            </div>

            <div class="form-group">
              <label class="form-label" for="description">Description</label>
              <textarea class="form-input" id="description" name="description" rows="3"><%= test.description || '' %></textarea>
            </div>

            <div class="form-group">
              <label class="form-label" for="course">Course / Category *</label>
              <select class="form-select" id="course" name="course" required>
                <option value="">Select a course</option>
                <% ['MERN Stack', 'Data Science', 'Python Full Stack', 'Java Full Stack', 'DevOps', 'Cloud Computing', 'Machine Learning', 'Digital Marketing', 'UI/UX Design'].forEach(c => { %>
                  <option value="<%= c %>" <%= test.course === c ? 'selected' : '' %>><%= c %></option>
                <% }) %>
              </select>
            </div>

            <div class="form-row">
              <div class="form-group">
                <label class="form-label" for="duration">Duration (minutes) *</label>
                <input type="number" class="form-input" id="duration" name="duration" value="<%= test.duration %>" min="5" max="180" required>
              </div>
              <div class="form-group">
                <label class="form-label" for="passingMarks">Passing Marks</label>
                <input type="number" class="form-input" id="passingMarks" name="passingMarks" value="<%= test.passingMarks %>" min="0">
              </div>
            </div>

            <!-- ===== Assessment Pricing Options ===== -->
            <div style="background: rgba(255,255,255,0.02); border: 1px solid var(--border); border-radius: 12px; padding: 18px 20px; margin-bottom: 22px;">
              <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 12px;">
                <label class="form-label" style="margin-bottom: 0; font-size: 0.85rem; color: #fff; text-transform: uppercase; letter-spacing: 0.06em;">
                  💰 Assessment Pricing &amp; Charges
                </label>
                <span class="badge badge-info" style="font-size: 0.7rem;">Optional / Paywall</span>
              </div>

              <div class="form-row">
                <div class="form-group" style="margin-bottom: 10px;">
                  <!-- <label class="form-label" for="originalPrice" style="color: var(--text-muted);">
                    My Pricing / Standard Price (₹)
                  </label>
                  <input type="number" class="form-input" id="originalPrice" name="originalPrice"
                    value="<%= test.originalPrice || 0 %>" min="0" placeholder="e.g. 999 (shows in light color with overline)"
                    oninput="updatePricingPreview()">
                  <small style="color: var(--text-muted); font-size: 0.74rem;">Original standard rate (displayed in light color with strikethrough)</small> -->
                </div>
                <div class="form-group" style="margin-bottom: 10px;">
                  <label class="form-label" for="price" style="color: var(--green);">
                    Offer Price / Payable Price (₹) *
                  </label>
                  <input type="number" class="form-input" id="price" name="price"
                    value="<%= test.price || 0 %>" min="0" placeholder="e.g. 499 (active discounted charge)"
                    oninput="updatePricingPreview()">
                  <small style="color: var(--green); font-size: 0.74rem;">Actual amount candidate pays (0 for Free)</small>
                </div>
              </div>

              <!-- Live preview -->
              <div id="pricingPreview" style="margin-top: 12px; padding: 10px 14px; background: rgba(0,0,0,0.3); border-radius: 8px; border: 1px dashed var(--border); display: flex; align-items: center; gap: 12px;">
                <span style="font-size: 0.78rem; color: var(--text-muted); font-weight: 600;">Candidate View:</span>
                <span id="previewOriginal" style="text-decoration: line-through; color: var(--text-muted); opacity: 0.65; font-size: 0.92rem; display: none;">₹0</span>
                <span id="previewOffer" style="color: var(--green); font-weight: 800; font-size: 1.05rem;">Free Assessment</span>
                <span id="previewBadge" class="badge badge-success" style="display: none; font-size: 0.7rem;">SPECIAL OFFER</span>
              </div>
            </div>

            <div class="form-check">
              <input type="checkbox" id="isActive" name="isActive" <%= test.isActive ? 'checked' : '' %>>
              <label for="isActive">Test is Active</label>
            </div>

            <!-- ===== Sub-tests Section ===== -->
            <div class="subtests-section">
              <div class="subtests-header">
                <h3>📂 Sub-tests / Sections</h3>
              </div>

              <div id="subTestsContainer">
                <% if (!test.subTests || test.subTests.length === 0) { %>
                  <p class="no-subtests-hint" id="noSubTestHint">No sub-tests yet. Click below to add sections.</p>
                <% } else { %>
                  <p class="no-subtests-hint" id="noSubTestHint" style="display:none;"></p>
                  <% test.subTests.forEach((st, idx) => { %>
                    <div class="subtest-card" id="subtest-card-<%= idx %>">
                      <div class="card-title">Sub-test #<%= idx + 1 %></div>
                      <button type="button" class="remove-btn" onclick="removeSubTest(<%= idx %>)">✕ Remove</button>

                      <!-- preserve existing _id so backend can match -->
                      <input type="hidden" name="subTests[<%= idx %>][_id]" value="<%= st._id %>">

                      <div class="form-group">
                        <label class="form-label">Sub-test Name *</label>
                        <input type="text" class="form-input" name="subTests[<%= idx %>][name]"
                          value="<%= st.name %>" required>
                      </div>
                      <div class="form-group">
                        <label class="form-label">Description</label>
                        <input type="text" class="form-input" name="subTests[<%= idx %>][description]"
                          value="<%= st.description || '' %>">
                      </div>
                      <div class="subtest-row">
                        <div class="form-group">
                          <label class="form-label">No. of Questions to Show (Leave blank for all)</label>
                          <input type="number" class="form-input" name="subTests[<%= idx %>][questionCount]"
                            value="<%= st.questionCount || '' %>" placeholder="All questions" min="1">
                        </div>
                        <div class="form-group">
                          <label class="form-label">Question Type *</label>
                          <select class="form-select" name="subTests[<%= idx %>][type]" required>
                            <option value="mcq"  <%= st.type === 'mcq'   ? 'selected' : '' %>>MCQ</option>
                            <option value="code" <%= st.type === 'code'  ? 'selected' : '' %>>Coding / Programming</option>
                            <option value="mixed"<%= st.type === 'mixed' ? 'selected' : '' %>>Mixed (MCQ + Coding)</option>
                          </select>
                        </div>
                      </div>
                    </div>
                  <% }) %>
                <% } %>
              </div>

              <button type="button" id="addSubTestBtn" onclick="addSubTest()">＋ Add Sub-test</button>
            </div>

            <div style="display: flex; gap: 12px; margin-top: 20px;">
              <button type="submit" class="btn btn-primary btn-lg">Update Test</button>
              <a href="/admin/tests/<%= test._id %>/questions" class="btn btn-outline btn-lg">Manage Questions</a>
              <a href="/admin/tests" class="btn btn-outline btn-lg">Cancel</a>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  let subTestCounter = <%= (test.subTests && test.subTests.length) ? test.subTests.length : 0 %>;

  function addSubTest() {
    const container = document.getElementById('subTestsContainer');
    const hint = document.getElementById('noSubTestHint');
    if (hint) hint.style.display = 'none';

    const idx = subTestCounter++;
    const card = document.createElement('div');
    card.className = 'subtest-card';
    card.id = `subtest-card-${idx}`;
    card.innerHTML = `
      <div class="card-title">Sub-test #${idx + 1}</div>
      <button type="button" class="remove-btn" onclick="removeSubTest(${idx})">✕ Remove</button>
      <div class="form-group">
        <label class="form-label">Sub-test Name *</label>
        <input type="text" class="form-input" name="subTests[${idx}][name]" placeholder="e.g., HTML, CSS, JavaScript" required>
      </div>
      <div class="form-group">
        <label class="form-label">Description</label>
        <input type="text" class="form-input" name="subTests[${idx}][description]" placeholder="Optional">
      </div>
      <div class="subtest-row">
        <div class="form-group">
          <label class="form-label">No. of Questions to Show (Leave blank for all)</label>
          <input type="number" class="form-input" name="subTests[${idx}][questionCount]" placeholder="All questions" min="1">
        </div>
        <div class="form-group">
          <label class="form-label">Question Type *</label>
          <select class="form-select" name="subTests[${idx}][type]" required>
            <option value="mcq">MCQ</option>
            <option value="code">Coding / Programming</option>
            <option value="mixed">Mixed (MCQ + Coding)</option>
          </select>
        </div>
      </div>
    `;
    container.appendChild(card);
  }

  function removeSubTest(idx) {
    const card = document.getElementById(`subtest-card-${idx}`);
    if (card) card.remove();
    const container = document.getElementById('subTestsContainer');
    if (container.querySelectorAll('.subtest-card').length === 0) {
      document.getElementById('noSubTestHint').style.display = '';
    }
  }

  function updatePricingPreview() {
    const orig = parseFloat(document.getElementById('originalPrice').value) || 0;
    const offer = parseFloat(document.getElementById('price').value) || 0;
    const previewOrig = document.getElementById('previewOriginal');
    const previewOffer = document.getElementById('previewOffer');
    const previewBadge = document.getElementById('previewBadge');

    if (orig > offer && offer >= 0) {
      previewOrig.style.display = 'inline';
      previewOrig.textContent = '₹' + orig;
      previewBadge.style.display = 'inline-flex';
      const pct = Math.round(((orig - offer) / orig) * 100);
      previewBadge.textContent = pct > 0 ? `${pct}% OFF` : 'OFFER';
    } else {
      previewOrig.style.display = 'none';
      previewBadge.style.display = 'none';
    }

    if (offer > 0) {
      previewOffer.textContent = '₹' + offer;
    } else {
      previewOffer.textContent = 'Free Assessment';
    }
  }
  updatePricingPreview();
</script>

<%- include('../partials/footer') %>

