<%- include('../partials/header') %>

<div class="dashboard-layout">
  <%- include('../partials/admin-sidebar', { active: 'dashboard' }) %>

  <div class="main-content">
    <div class="page-header">
      <div class="page-header-actions">
        <div>
          <h1>Administrator Overview</h1>
          <p>Welcome back, <%= currentUser.name %>! Monitor candidate assessments, evaluations, and review queues.</p>
        </div>
        <div style="display: flex; gap: 10px;">
          <a href="/admin/tests/create" class="btn btn-primary btn-sm">+ Create Assessment</a>
          <a href="/admin/students/create" class="btn btn-outline btn-sm">+ Add Candidate</a>
        </div>
      </div>
    </div>

    <div class="page-body">
      <%- include('../partials/alerts') %>

      <!-- Stats Grid -->
      <div class="stats-grid">
        <a href="/admin/students" class="stat-card" style="text-decoration: none; color: inherit;">
          <div class="stat-icon green">👥</div>
          <div class="stat-value"><%= totalStudents %></div>
          <div class="stat-label">Total Candidates</div>
        </a>
        <a href="/admin/tests" class="stat-card" style="text-decoration: none; color: inherit;">
          <div class="stat-icon green">📋</div>
          <div class="stat-value"><%= totalTests %></div>
          <div class="stat-label">Total Assessments</div>
        </a>
        <a href="/admin/results" class="stat-card" style="text-decoration: none; color: inherit;">
          <div class="stat-icon orange">📈</div>
          <div class="stat-value"><%= totalResults %></div>
          <div class="stat-label">Test Submissions</div>
        </a>
        <a href="/admin/payments" class="stat-card" style="text-decoration: none; color: inherit;">
          <div class="stat-icon green">💳</div>
          <div class="stat-value"><%= totalPayments %> <small style="font-size: 0.85rem; font-weight: 600; opacity: 0.85;">(₹<%= totalCollected %>)</small></div>
          <div class="stat-label">Paid Candidates</div>
        </a>
      </div>

      <!-- Recent Data -->
      <div class="section-grid">
        <!-- Recent Tests -->
        <div class="card">
          <div class="card-header">
            <h3>📋 Recent Assessments</h3>
            <a href="/admin/tests" class="btn btn-sm btn-outline">View All</a>
          </div>
          <div class="table-responsive">
            <table class="data-table">
              <thead>
                <tr>
                  <th>Title</th>
                  <th>Domain</th>
                  <th>Questions</th>
                  <th>Status</th>
                </tr>
              </thead>
              <tbody>
                <% if (recentTests.length === 0) { %>
                  <tr><td colspan="4" style="text-align:center; padding:24px; color:var(--text-muted);">No assessments created yet</td></tr>
                <% } else { %>
                  <% recentTests.forEach(test => { %>
                    <tr>
                      <td><strong style="color: #fff"><%= test.title %></strong></td>
                      <td><span class="badge badge-primary"><%= test.course %></span></td>
                      <% const qCount = (test.questions ? test.questions.length : 0) + ((test.subTests || []).reduce((sum, st) => sum + ((st.questions && st.questions.length) || 0), 0)); %><td><%= qCount %> Qs</td>
                      <td>
                        <span class="badge <%= test.isActive ? 'badge-success' : 'badge-danger' %>">
                          <%= test.isActive ? 'Active' : 'Inactive' %>
                        </span>
                      </td>
                    </tr>
                  <% }) %>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>

        <!-- Recent Students -->
        <div class="card">
          <div class="card-header">
            <h3>👥 Recent Candidates</h3>
            <a href="/admin/students" class="btn btn-sm btn-outline">View All</a>
          </div>
          <div class="table-responsive">
            <table class="data-table">
              <thead>
                <tr>
                  <th>Candidate</th>
                  <th>Domain Track</th>
                  <th>Status</th>
                </tr>
              </thead>
              <tbody>
                <% if (recentStudents.length === 0) { %>
                  <tr><td colspan="3" style="text-align:center; padding:24px; color:var(--text-muted);">No candidates registered yet</td></tr>
                <% } else { %>
                  <% recentStudents.forEach(student => { %>
                    <tr>
                      <td>
                        <strong style="color: #fff"><%= student.name %></strong>
                        <br><small style="color:var(--text-muted)"><%= student.email %></small>
                      </td>
                      <td><span class="badge badge-info"><%= student.course || 'General' %></span></td>
                      <td>
                        <span class="badge <%= student.isActive ? 'badge-success' : 'badge-danger' %>">
                          <%= student.isActive ? 'Active' : 'Inactive' %>
                        </span>
                      </td>
                    </tr>
                  <% }) %>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- Candidate Submissions -->
      <div style="margin-top: 24px;">
        <div class="card">
          <div class="card-header" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px;">
            <div>
              <h3>📈 All Candidate Submissions (<%= recentResults.length %>)</h3>
              <p style="color: var(--text-muted); font-size: 0.85rem; margin-top: 2px;">All candidates who have submitted their test assessments</p>
            </div>
            <div style="display: flex; gap: 10px; align-items: center;">
              <input type="text" id="dashSubmissionSearch" placeholder="🔍 Search submissions..." 
                     style="padding: 6px 12px; background: rgba(255,255,255,0.06); border: 1px solid var(--border); border-radius: 6px; color: #fff; font-size: 0.85rem; outline: none; min-width: 200px;"
                     onkeyup="filterDashSubmissions()">
              <a href="/admin/results" class="btn btn-sm btn-outline">Full Results Page →</a>
            </div>
          </div>
          <div class="table-responsive">
            <table class="data-table" id="dashSubmissionsTable">
              <thead>
                <tr>
                  <th>Candidate</th>
                  <th>Assessment</th>
                  <th>Track / Course</th>
                  <th>Score</th>
                  <th>Percentage</th>
                  <th>Result Status</th>
                  <th>Submitted At</th>
                  <th>Action</th>
                </tr>
              </thead>
              <tbody>
                <% if (recentResults.length === 0) { %>
                  <tr><td colspan="8" style="text-align:center; padding:24px; color:var(--text-muted);">No submissions yet</td></tr>
                <% } else { %>
                  <% recentResults.forEach(result => { %>
                    <tr>
                      <td>
                        <strong style="color: #fff"><%= result.student ? result.student.name : 'Unknown' %></strong>
                        <br><small style="color: var(--text-muted)"><%= result.student ? result.student.email : '' %></small>
                      </td>
                      <td><%= result.test ? result.test.title : 'Deleted Assessment' %></td>
                      <td><span class="badge badge-info"><%= result.test ? result.test.course : (result.student && result.student.course ? result.student.course : 'General') %></span></td>
                      <td><strong><%= result.obtainedMarks %> / <%= result.totalMarks %></strong></td>
                      <td>
                        <span style="color: <%= result.percentage >= 70 ? 'var(--success)' : result.percentage >= 40 ? 'var(--warning)' : 'var(--danger)' %>; font-weight: 700;">
                          <%= result.percentage %>%
                        </span>
                      </td>
                      <td>
                        <span class="badge <%= result.isPassed ? 'badge-success' : 'badge-danger' %>">
                          <%= result.isPassed ? '✅ Passed' : '❌ Needs Review' %>
                        </span>
                      </td>
                      <td><%= new Date(result.submittedAt).toLocaleDateString('en-IN') %></td>
                      <td>
                        <a href="/admin/results/<%= result._id %>" class="btn btn-sm btn-outline">👁️ View</a>
                      </td>
                    </tr>
                  <% }) %>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <script>
        function filterDashSubmissions() {
          const query = document.getElementById('dashSubmissionSearch').value.toLowerCase();
          const rows = document.querySelectorAll('#dashSubmissionsTable tbody tr');
          rows.forEach(row => {
            const text = row.innerText.toLowerCase();
            row.style.display = text.includes(query) ? '' : 'none';
          });
        }
      </script>

    </div>
  </div>
</div>

<%- include('../partials/footer') %>
