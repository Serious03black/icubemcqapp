<%- include('../partials/header') %>

<div class="dashboard-layout">
  <%- include('../partials/admin-sidebar', { active: 'dashboard' }) %>

  <div class="main-content">
    <div class="page-header">
      <div class="page-header-actions">
        <div>
          <h1>Administrator Overview</h1>
          <p>Welcome back, <%= currentUser.name %>! Monitor candidate assessments, evaluations, and review queues.</p>
        </div>
        <div style="display: flex; gap: 10px;">
          <a href="/admin/tests/create" class="btn btn-primary btn-sm">+ Create Assessment</a>
          <a href="/admin/students/create" class="btn btn-outline btn-sm">+ Add Candidate</a>
        </div>
      </div>
    </div>

    <div class="page-body">
      <%- include('../partials/alerts') %>

      <!-- Stats Grid -->
      <div class="stats-grid">
        <div class="stat-card">
          <div class="stat-icon green">👥</div>
          <div class="stat-value"><%= totalStudents %></div>
          <div class="stat-label">Total Candidates</div>
        </div>
        <div class="stat-card">
          <div class="stat-icon green">📋</div>
          <div class="stat-value"><%= totalTests %></div>
          <div class="stat-label">Total Assessments</div>
        </div>
        <div class="stat-card">
          <div class="stat-icon blue">✅</div>
          <div class="stat-value"><%= activeTests %></div>
          <div class="stat-label">Active Tests</div>
        </div>
        <div class="stat-card">
          <div class="stat-icon orange">📈</div>
          <div class="stat-value"><%= totalResults %></div>
          <div class="stat-label">Submissions</div>
        </div>
      </div>

      <!-- Recent Data -->
      <div class="section-grid">
        <!-- Recent Tests -->
        <div class="card">
          <div class="card-header">
            <h3>📋 Recent Assessments</h3>
            <a href="/admin/tests" class="btn btn-sm btn-outline">View All</a>
          </div>
          <div class="table-responsive">
            <table class="data-table">
              <thead>
                <tr>
                  <th>Title</th>
                  <th>Domain</th>
                  <th>Questions</th>
                  <th>Status</th>
                </tr>
              </thead>
              <tbody>
                <% if (recentTests.length === 0) { %>
                  <tr><td colspan="4" style="text-align:center; padding:24px; color:var(--text-muted);">No assessments created yet</td></tr>
                <% } else { %>
                  <% recentTests.forEach(test => { %>
                    <tr>
                      <td><strong style="color: #fff"><%= test.title %></strong></td>
                      <td><span class="badge badge-primary"><%= test.course %></span></td>
                      <td><%= test.questions ? test.questions.length : 0 %> Qs</td>
                      <td>
                        <span class="badge <%= test.isActive ? 'badge-success' : 'badge-danger' %>">
                          <%= test.isActive ? 'Active' : 'Inactive' %>
                        </span>
                      </td>
                    </tr>
                  <% }) %>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>

        <!-- Recent Students -->
        <div class="card">
          <div class="card-header">
            <h3>👥 Recent Candidates</h3>
            <a href="/admin/students" class="btn btn-sm btn-outline">View All</a>
          </div>
          <div class="table-responsive">
            <table class="data-table">
              <thead>
                <tr>
                  <th>Candidate</th>
                  <th>Domain Track</th>
                  <th>Status</th>
                </tr>
              </thead>
              <tbody>
                <% if (recentStudents.length === 0) { %>
                  <tr><td colspan="3" style="text-align:center; padding:24px; color:var(--text-muted);">No candidates registered yet</td></tr>
                <% } else { %>
                  <% recentStudents.forEach(student => { %>
                    <tr>
                      <td>
                        <strong style="color: #fff"><%= student.name %></strong>
                        <br><small style="color:var(--text-muted)"><%= student.email %></small>
                      </td>
                      <td><span class="badge badge-info"><%= student.course || 'General' %></span></td>
                      <td>
                        <span class="badge <%= student.isActive ? 'badge-success' : 'badge-danger' %>">
                          <%= student.isActive ? 'Active' : 'Inactive' %>
                        </span>
                      </td>
                    </tr>
                  <% }) %>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- Recent Results -->
      <div style="margin-top: 24px;">
        <div class="card">
          <div class="card-header">
            <h3>📈 Recent Candidate Submissions</h3>
            <a href="/admin/results" class="btn btn-sm btn-outline">View All</a>
          </div>
          <div class="table-responsive">
            <table class="data-table">
              <thead>
                <tr>
                  <th>Candidate</th>
                  <th>Assessment</th>
                  <th>Score</th>
                  <th>Review Status</th>
                  <th>Submitted At</th>
                </tr>
              </thead>
              <tbody>
                <% if (recentResults.length === 0) { %>
                  <tr><td colspan="5" style="text-align:center; padding:24px; color:var(--text-muted);">No submissions yet</td></tr>
                <% } else { %>
                  <% recentResults.forEach(result => { %>
                    <tr>
                      <td><strong style="color: #fff"><%= result.student ? result.student.name : 'Unknown' %></strong></td>
                      <td><%= result.test ? result.test.title : 'Deleted Assessment' %></td>
                      <td><%= result.obtainedMarks %> / <%= result.totalMarks %> (<%= result.percentage %>%)</td>
                      <td>
                        <span class="badge <%= result.isPassed ? 'badge-success' : 'badge-danger' %>">
                          <%= result.isPassed ? 'Passed' : 'Needs Review' %>
                        </span>
                      </td>
                      <td><%= new Date(result.submittedAt).toLocaleDateString('en-IN') %></td>
                    </tr>
                  <% }) %>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </div>

    </div>
  </div>
</div>

<%- include('../partials/footer') %>
